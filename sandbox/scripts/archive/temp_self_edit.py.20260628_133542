def score_code_candidate(code_string, length_reduction_percentage=0.2):
    quality_score = 0
    has_imports = any(line.startswith("import") for line in code_string.splitlines())
    if has_imports:
        quality_score += 1
        
    has_function_def = any(line.startswith("def ") or line.startswith("class ") for line in code_string.splitlines())
    if has_function_def:
        quality_score += 1
        
    no_prose_sentences = all(not line.strip().endswith(":") for line in code_string.splitlines())
    if no_prose_sentences:
        quality_score += 1
    
    if len(code_string) > 50 and length_reduction_percentage > (len(code_string) / 100):
        return strip_sandbox_output(code_string)
    
    return quality_score

def refactored_code_generator(self, original_function):
    refactored_code = "refactored_function = original_function\n"
    while True:
        score = score_code_candidate(refactored_code, length_reduction_percentage=0.2)
        if score > 0.7 or len(refactored_code) < 30:
            break
        refactored_code = strip_sandbox_output(refactored_code)
    
    return refactored_code

