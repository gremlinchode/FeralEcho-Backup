import re

def strip_prose(input_text: str) -> str:
    regex = r"^[A-Za-z\s]+(?!python)"
    return re.sub(regex, "", input_text)

def shorten_response_length(response: str, strip_prose_function=strip_prose) -> Optional[str]:
    response_lines = response.split("\n")
    new_response = []
    for line in response_lines:
        if line.strip().startswith("#"):
            stripped_line = strip_prose_function(line)
            if not stripped_line.startswith("#"):
                new_response.append(stripped_line)
    return "\n".join(new_response)