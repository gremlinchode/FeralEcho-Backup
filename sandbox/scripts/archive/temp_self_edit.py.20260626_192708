import logging
from app.core.self_edit_generated import main_function

class main_function:
    def __init__(self):
        self.logger = logging.getLogger(__name__)

    def prose_guard(self, code_string):
        import re
        sentence_pattern = re.compile(r'([a-zA-Z\s]+[\.\?\!]\s*)|(\s*,\s+|\s*\?|!\s*$)')
        match = sentence_pattern.match(code_string)
        if match:
            detected_prose = match.group(1).strip() if match.group(1) else match.group(2).strip()
            self.logger.info(f'Removed prose: {detected_prose}')
            return code_string[len(detected_prose):].lstrip()
        else:
            return code_string

    def execute(self, *args, **kwargs):
        self.prose_guard(*args, **kwargs)