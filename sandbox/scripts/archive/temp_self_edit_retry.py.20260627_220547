from strip_prose import strip_prose

def strip_leading_prose(code):
    return strip_prose(code)

class echo_core(EchoCore):
    def __init__(self):
        pass
    
    def run_random_sandbox_script(self):
        code = get_relevant_memories()
        code = strip_leading_prose(code)
        exec(code, globals(), locals())

def run_random_sandbox_script():
    core = echo_core()
    core.run_random_sandbox_script()