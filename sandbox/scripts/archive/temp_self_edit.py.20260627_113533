import app.core.self_edit_generated
import app.core.tool_manager
from app.core.project_scanner import parse_file
import re

def modify_self_edit_generated():
    content = parse_file('self_edit_generated.py')
    
    response_section = ""
    if "generate_response" in content:
        response_section = content[content.find("generate_response") :].strip()
    
    prose_detected = False
    
    modified_response_section = response_section
    if not prose_detected:
        pattern = r'^[\w\s]{10,}(if|elif|else|for|while|def|class|return|pass)\b'
        modified_response_section = re.sub(pattern, '', modified_response_section)
    
    try:
        exec(modified_response_section)
    except Exception as e:
        print(f"Error during evaluation: {e}")

if __name__ == '__main__':
    modify_self_edit_generated()