import os

def scan_project():
    file_path = '/Users/richietate/Desktop/FeralEcho/scan_project.py'
    with open(os.path.abspath(file_path), 'r+') as file:
        content = file.read()
        content = content.replace('file_', 'os.path.abspath(file_path)')
        file.seek(0)
        file.write(content)
        file.truncate()
        file.close()

    print("Replaced 'file_' with 'os.path.abspath(file_path)' to avoid hardcoding paths.")
    print("Changes committed successfully.")