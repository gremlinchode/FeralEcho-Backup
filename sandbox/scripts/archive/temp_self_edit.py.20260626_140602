# Import necessary modules
import app.core.self_edit_generated
import app.core.river_deliberation
from app.core.project_scanner import ProjectScanner
from app.core.sandbox_interface import SandboxInterface
import re

def strip_leading_prose(code):
    try:
        return re.sub(r"^.*?:\s*", "", code, flags=re.MULTILINE)
    except Exception as e:
        print(f"Error in strip_leading_prose: {e}")
        return code

def modify_self_edit_generated():
    scanner = ProjectScanner()
    scanner.scan_project('app/core')
    main_function = scanner.get_main_function('self_edit_generated.py')

    if main_function:
        original_code = main_function['source']
        modified_code = original_code
        try:
            # Add the prose detection guard
            modified_code = f"""
def main():
    generated_code = ...  # Get generated code from your logic here
    stripped_code = strip_leading_prose(generated_code)
    exec(stripped_code)
"""

        except Exception as e:
            print(f"Error modifying self_edit_generated.py: {e}")
            return

        # Save the modified code back to the file
        river_deliberation.reflect_and_modify('self_edit_generated.py', modified_code)

        # Run a test in the sandbox
        sandbox = SandboxInterface()
        sandbox.run_test('self_edit_generated.py')
    else:
        print("Main function not found in self_edit_generated.py.")

if __name__ == "__main__":
    modify_self_edit_generated()