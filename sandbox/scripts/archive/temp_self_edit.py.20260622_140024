# import os and re libraries
import os; import re

file_path = "/Users/richietate/Desktop/FeralEcho/echo.py"

with open(file_path, "r") as f:
    content = f.read()

corrected_line = "with open(file_path, 'rb')"
content = re.sub('with open\\(file_path, "r"\\)', corrected_line, content)

with open(file_path, "w") as f:
    f.write(content)

print("Changed: 'with open(file_path, \"r\")' to 'with open(file_path, 'rb')'. Reason: Avoid potential issues.")