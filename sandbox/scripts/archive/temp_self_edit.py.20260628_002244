import re

def strip_prose(content):
    pattern = re.compile(r"^\s*([A-Za-z\s]+)\n.*\b(import|class|def|for|while|if|elif|else|(true|false|None))\b")
    stripped_content = ""
    for match in pattern.finditer(content):
        stripped_content += content[:match.start()].rstrip() + "\n"
    return stripped_content

with open("app/core/self_edit_generated.py", "w") as f:
    f.write(strip_prose(""))