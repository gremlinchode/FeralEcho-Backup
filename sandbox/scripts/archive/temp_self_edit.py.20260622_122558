import os

def edit_file():
    file_path = "/Users/richietate/Desktop/FeralEcho/echo.py"
    with open(file_path, 'r+') as f:
        contents = f.read()
        if "import os" in contents:
            location = contents.index("import os")
            contents = contents[:location] + "file_path = os.path.abspath(os.path.realpath(__file__))\nwith open(file_path, 'r') as f:" + contents[location:]
        with open(file_path, 'w') as f:
            f.write(contents)