import re

def strip_prose(code):
    sentence_pattern = re.compile(r'^\W*\S+')
    stripped_code = sentence_pattern.sub('', code)
    return stripped_code

code_output = ...  # initialize the output
stripped_code_output = strip_prose(code_output)
code_output = stripped_code_output

with open('app/core/self_edit_generated.py', 'w') as f:
    f.write(str(code_output))