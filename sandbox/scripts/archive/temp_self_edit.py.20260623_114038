import os
import re
import sys

def main():
    project_dir = "/Users/richietate/Desktop/FeralEcho"
    file_path = os.path.join(project_dir, "response_generator.py")
    with open(file_path, 'r') as f:
        content = f.read()
    new_content = re.sub(r'impo', 'imposing', content)
