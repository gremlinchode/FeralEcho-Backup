import re

def strip_prose(code):
    pattern = re.compile(r'^(?:It was|I believe that|For me,|To me,|From my perspective,)[^\n]*\n')
    return pattern.sub('', code)

def sandbox_sanitize(code):
    return strip_prose(code)

from app.core.self_edit_generated import *
self_edit_generated.strip_prose = sandbox_sanitize

