import os

def fix_scanner():
    with open('/Users/richietate/Desktop/FeralEcho/scanner.py', 'w+', encoding='utf-8') as file:
        code = file.read()
        if len(code) == 0:
            modified_code = "'...'\\n"
            file.write(modified_code)
        else:
            file.seek(len(code))
            file.write('...\n')
    print("One line was added to scanner.py.")
    
    if os.path.getsize('/Users/richietate/Desktop/FeralEcho/scanner.py') > 0:
        print("Changes were made and saved successfully.")
    else:
        print("Error: File not found.")

