original_strip_prose = strip_prose

def modified_strip_prose(text):
    import re
    sentence_endings = r'[.!?]'
    split_text = re.split(sentence_endings, text)
    
    for part in split_text:
        if not part.strip().endswith(('import', 'def', 'class', 'from')):
            break
        
    return part + re.findall(sentence_endings, text)[-1]

strip_prose = modified_strip_prose