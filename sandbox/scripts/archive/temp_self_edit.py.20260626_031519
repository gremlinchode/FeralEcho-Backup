# import required modules
import app.core.awareness_tools_integration
import app.core.project_scanner
import app.core.tool_manager

discover_installed_packages = app.core.awwareness_tools_integration.discover_installed_packages()

memory_bridge_path = next((file for file in app.core.project_scanner.list_python_files() if file == 'memory_bridge.py'), None)
if memory_bridge_path is None:
    raise ValueError('Memory bridge file not found')

memory_bridge_contents = app.core.project_scanner.parse_file(memory_bridge_path)

rebuild_vector_memory_function = [line.strip() for line in memory_bridge_contents.split('\n') if line.strip().startswith('def rebuild_vector_memory')][0]

tool = app.core.tool_manager.Tool()
tool.module_path = memory_bridge_path
tool.function_name = 'rebuild_vector_memory'

app.core.awareness_tools_integration.register_package_functions(tool)

app.core.awwareness_tools_integration.safe_wrapper.enable()