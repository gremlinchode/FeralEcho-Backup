from app.core.tool_manager import ToolManager as tool_manager
import re

def strip_leading_natural_language(text):
    while text and not text.strip().startswith(('#', 'import', 'def', 'class')):
        text = text.strip()
    return text or ""

def modify_main_function():
    try:
        text = app.core.echo_model_guided_orchestrator("reasoning")
        if 'reasoning' in text:
            text = strip_leading_natural_language(text)
        if not re.match(r'[\w\W]+', text):
            raise Exception("Invalid syntax")
        app.core.echo_model_guided_orchestrator(text)
    except Exception as e:
        tool_manager.load_tool('prose_guard')
        app.core.memory_tools.log_memory_edit(e)
        raise e