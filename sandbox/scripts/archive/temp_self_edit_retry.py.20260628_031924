# import re
from app.core.self_edit_generated import strip_prose

def tighten_guard(code):
    pattern = re.compile(r'^\s*(?:(?:[^a-zA-Z0-9_]|(?![^({[].*?[)]])|(?:[{}[]|))\n)?')
    code = pattern.sub('', code, 0, None)
    return code

def modified_strip_prose(code):
    code = tighten_guard(code)
    return strip_prose(code)

strip_prose = modified_strip_prose