import app.core.self_edit_generated
from typing import Dict

def score_candidate_code(candidates: str) -> int:
    scores: Dict[str, int] = {'has_imports': 0, 'has_function_def': 0, 'no_prose_sentences': 0}

    if "import" in candidates or "from" in candidates:
        scores['has_imports'] += (3 if "import" in candidates else 2)

    function_pattern = r'def\s+\w+\(.*?\):'
    functions = re.findall(function_pattern, candidates)
    scores['has_function_def'] = len(functions)

    prose_pattern = r'[A-Z][^.!?]*[.!?]'
    sentences = re.findall(prose_pattern, candidates)
    scores['no_prose_sentences'] = len(sentences) if len(sentences) > 0 else 3

    total_score: int = sum(scores.values())
    
    return total_score