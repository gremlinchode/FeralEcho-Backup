def strip_prose_tightened(code):
    lines = code.splitlines()
    result = []
    in_prose = False
    for line in lines:
        line = line.strip()
        if not line:
            continue
        if in_prose:
            if line.startswith(('the', 'a', 'an')):
                continue
            elif line.startswith(('and', 'but', 'or', 'so', 'because')):
                continue
            else:
                result.append(line)
        else:
            if line.startswith(('def ', 'class ', 'import ', 'from ')):
                in_prose = True
                result.append(line)
            else:
                result.append(line)
    return "\n".join(result)

strip_prose = lambda code: strip_prose_tightened(code)

self.__init__.append(strip_prose_tightened)