# import necessary modules from FeralEcho: from app.core.self_edit_generated import modify_main_function; import re

from app.core.project_scanner import list_python_files
import re
app = None

modify_main_function = lambda func: strip_prose(func) if isinstance(func, str) and any(line.strip().startswith(("print", "return")) for line in func.split('\n')) else func

strip_prose = lambda code: re.sub(r'^[A-Za-z\s]+', '', code)

for func in [func for func in list_python_files("app/core/self_edit_generated.py").split('\n') if any(line.strip().startswith(("print", "return")) for line in func.split('\n'))]:
    modify_main_function = lambda x: strip_prose(x) if isinstance(x, str) and any(line.strip().startswith(("print", "return")) for line in x.split('\n')) else x

app.core.tool_manager.activate_behavior('prose_detection')

self_edit_generated.modify_main_function = modify_main_function

if __name__ == "__main__":
    app.autonomous_loop.run_autonomous_sandbox_cycle()