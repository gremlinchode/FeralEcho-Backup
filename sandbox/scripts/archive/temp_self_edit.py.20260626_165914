# import re

def score_candidate_code(candidate_code):
    quality_score = 0

    if re.search(r'\bimport\b', candidate_code):
        quality_score += 1

    function_matches = re.findall(r'def\s+([a-zA-Z_][a-zA-Z0-9_]*)\(', candidate_code, re.IGNORECASE)
    if function_matches:
        quality_score += 2

    sentences = candidate_code.split('.')
    prose_sentence_count = len([s for s in sentences if not re.match(r'#|\/\*', s, re.MULTILINE)])
    if prose_sentence_count > 0:
        quality_score += 3

    return quality_score