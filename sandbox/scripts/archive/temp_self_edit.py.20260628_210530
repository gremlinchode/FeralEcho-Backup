import re
from app.core.self_edit_generated import strip_prose, score_code_candidate

def refactored_strip_prose(code: str) -> str:
    pattern = r'^[A-Z].*?(?:\.[^A-Z]*\.){1,3}'
    return re.sub(pattern, '', code)

def refactored_score_code_candidate(candidate_code: str) -> int:
    score = 0
    stripped_code = refactored_strip_prose(candidate_code).strip()
    
    if re.search(r'import\s+\w+', candidate_code):
        score += 1
    
    if re.search(r'def\s+\w+\s*\(', stripped_code) and stripped_code:
        score += 2
    elif re.search(r'def\s+\w+\s*\(', stripped_code):
        score += 1
    
    lines = candidate_code.split('\n')
    code_lines = [line.strip() for line in lines if not line.startswith('#') and '"' not in line]
    
    if all(re.match(r'^\w+\s*\(', line) for line in code_lines):
        score += 2
    elif any(re.match(r'^\w+\s*\(', line) for line in code_lines):
        score += 1
    
    return score