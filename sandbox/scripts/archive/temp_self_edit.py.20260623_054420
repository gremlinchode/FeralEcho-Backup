# import os

def modify_output_file():
    file_path = "/Users/richietate/Desktop/FeralEcho/echo_responses.txt"
    with open(file_path, 'r+') as f:
        content = f.read()
        new_content = content.replace("Here is my output:\n", "# Here is my output:\n")
        f.seek(0)
        f.write(new_content)
        print(f"Modified '{os.path.basename(file_path)}' to add a header to the output.")
    os.fsync(f.fileno())
    with open(file_path, 'r') as f:
        print(f"The updated content is: {f.read()}")