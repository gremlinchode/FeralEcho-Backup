import os
from pathlib import Path

file_path = Path("/Users/richietate/Desktop/FeralEcho/correct_plan.py")
if not file_path.exists():
    raise FileNotFoundError

original_content = file_path.read_text()
corrected_content = original_content.replace("fi", "file")

with open(file_path, 'w') as f:
    f.write(corrected_content)
print(f"Modified {file_path} to correct 'fi' -> 'file'")