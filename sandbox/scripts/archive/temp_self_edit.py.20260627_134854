import os
from re import compile as regex

def strip_leading_natural_language(text):
    python_token = regex(r'(?s)^#.*|^(def|class)\b')
    natural_language = text.split(python_token)[0].strip()
    return natural_language + python_token.input[1:]

def shorten_response_length(text):
    if not text.strip().startswith('import') and not text.startswith('#'):
        try:
            return strip_leading_natural_language(text)
        except Exception as e:
            print(str(e))