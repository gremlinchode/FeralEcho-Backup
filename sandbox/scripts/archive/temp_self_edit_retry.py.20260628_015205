import re
from app.core.self_edit_generated import strip_prose

def revised_strip_prose(code):
    pattern = r'^\s*"?((?:[^\"]|[\\\"]).)*"?\n\s*[^#]*'
    match = re.match(pattern, code)
    if match:
        return re.sub(pattern, '', code, 1).strip()
    else:
        return strip_prose(code)

revised_strip_prose.revised = revised_strip_prose