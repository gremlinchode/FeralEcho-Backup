def strip_prose(code):
    import re
    stripped_code = code
    if re.search(r'\b(sentence|paragraph)\b', code, re.IGNORECASE).group():
        tokens = code.split()
        for token in tokens:
            if re.match(r'^[a-zA-Z0-9=]+$', token):
                leading_sentence = ' '.join(tokens[:tokens.index(token)])
                stripped_code = re.sub(f'^{re.escape(leading_sentence)}', '', stripped_code, flags=re.MULTILINE)
    return stripped_code