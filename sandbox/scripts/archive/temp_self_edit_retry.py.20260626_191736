import re

tool_manager = app.core.tool_manager.get_tool_manager()
file_data = app.core.project_scanner.parse_file('app/core/self_edit_generated.py')

def modify_code(code):
    prose_guard = re.compile(r'^(?!\s*\w+\s*=\s*[\'"][^"]+["\']|print\s*\().*').sub('', code)
    return prose_guard.strip()

file_data['main_function'] = modify_code(file_data['main_function'])
app.core.project_scanner.parse_file('app/core/self_edit_generated.py')
app.core.project_scanner.list_python_files()