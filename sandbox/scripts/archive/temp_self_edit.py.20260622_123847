import os
import re

file_path = '/Users/richietate/Desktop/FeralEcho/echo.py'
with open(file_path, "r+") as file:
    current_content = file.read()
    
modified_line = re.sub(r'c', 'while True:', current_content)
file.seek(0); file.truncate(); file.write(modified_line)

print("Modified line 38, replacing 'c' with 'while True:'.")