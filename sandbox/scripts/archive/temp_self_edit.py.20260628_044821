from detect_functions_and_classes import detect_functions_and_classes
from get_most_negative_verse import get_most_negative_verse

with open('self_edit_generated.py', 'r') as file:
    code = file.read()

blocks, prose = parse_file(code)

functions_classes = detect_functions_and_classes(code)
verified_blocks = []

for block in blocks:
    if get_most_negative_verse(block):
        stripped_block = strip_prose(block)
        verified_blocks.append(stripped_block)

with open('self_edit_generated.py', 'w') as file:
    file.write(''.join(verified_blocks))