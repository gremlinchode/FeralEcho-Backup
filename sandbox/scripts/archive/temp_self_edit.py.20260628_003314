import strip_prose

def sanitize_output(input_string):
    if bool(re.match(r'^[^)]*\(.+?|^\/\*.*?^\s*\/\/?.*', input_string, re.IGNORECASE)):
        return input_string.split(' ', 1)[1]
    elif re.search(r'\b(import|def|class)\b', input_string, re.IGNORECASE):
        return input_string
    else:
        for token in input_string.split():
            if token[0].isalpha() and (token == "import" or token == "def" or token == "class"):
                return ' '.join(input_string.split()[input_string.split().index(token):])
        return input_string