def strip_leading_natural_language(text):
    while text and not text[0].isspace():
        text = text[1:].strip()
    return text or ""

for line in open('app/core/self_edit_generated.py', 'r').readlines():
    if 'reasoning' in line:
        line = strip_leading_natural_language(line)
open('app/core/self_edit_generated.py', 'w').write('\n'.join([line] + open('app/core/self_edit_generated.py', 'r').readlines()[len(open('app/core/self_edit_generated.py', 'r').readlines())-1:]))

