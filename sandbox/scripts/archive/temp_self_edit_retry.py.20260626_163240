import re

def remove_prose(code):
    pattern = r"^\s*(.*?)[.!?]\n(.*)"  # Matches text until a punctuation mark followed by newline
    match = re.search(pattern, code, re.MULTILINE | re.DOTALL) 

    if match:
        cleaned_code = match.group(2) # Keeps the content after the detected prose
        return cleaned_code
    else:
        return code  # Return original code if no prose is found

