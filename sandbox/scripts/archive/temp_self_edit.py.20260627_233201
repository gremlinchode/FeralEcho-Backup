def strip_prose(text):
    regex_pattern = re.compile(r'^\W+(?!.*[a-zA-Z]).*', flags=re.MULTILINE)
    stripped_text = re.sub(regex_pattern, '', text)
    if len(stripped_text) < len(text):
        print(f"Prose-detection guard triggered! Stripped {len(text) - len(stripped_text)} characters.")
    return stripped_text

self_edit_generated.strip_prose = strip_prose

