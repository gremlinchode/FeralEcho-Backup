def strip_prose(input_string):
    for line in input_string.split('\n'):
        if line.lstrip().startswith('if ') or line.lstrip().startswith('class ') or line.lstrip().startswith('def '):
            return line
    return ''

def main_function():
    result = refactor_main_function()
    return strip_prose(result)

