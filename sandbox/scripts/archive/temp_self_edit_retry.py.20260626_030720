from app.core.memory_bridge import memory_bridge
import app.core.tool_manager as tool_manager
import app.core.awareness_tools_integration as awareness_tools_integration
import app.echo_model_guided_orchestrator as echo_model_guided_orchestrator
import app.core.memory_tools as memory_tools
import datetime

tool_manager.load_tool('memory_bridge.rebuild_vector_memory')
awareness_installed_packages = awareness_tools_integration.discover_installed_packages()

if 'rebuild_vector_memory' in awareness_installed_packages:
    function = memory_bridge.rebuild_vector_memory
    echo_model_guided_orchestrator.start_autonomous_thread(function=function)
    rebuild_result = function()
    memory_tools.log_memory_event('rebuild_vector_memory', timestamp=datetime.datetime.now(), parameters={'function': function.__name__, 'result': rebuild_result})