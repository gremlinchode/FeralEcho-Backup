# Import def class 
import app.core.self_edit_generated

def score_candidate_code(input_string):
    has_imports = 0
    has_function_def = 0
    no_prose_sentences = 0
    
    if "import" in input_string:
        has_imports += 1
    if "def " in input_string or "class " in input_string:
        has_function_def += 1
    if not any(char.isalpha() for line in input_string.split("\n")):
        no_prose_sentences += 1
    
    return has_imports + has_function_def + no_prose_sentences