import os
import importlib
from app.core.self_edit_generated import strip_prose, run_random_sandbox_script, shorten_response_length

def wrapper(output):
    return strip_prose(output)

def combine_functions(input_output):
    input_output = strip_prose(input_output)
    return input_output

run_random_sandbox_script = lambda: combine_functions(run_random_sandbox_script())

def preprocess_output(output):
    if '...' in output:
        return wrapper(output)
    else:
        return output

run_random_sandbox_script = lambda: preprocess_output(run_random_sandbox_script())

importlib.import_module('app.core.self_edit_generated')