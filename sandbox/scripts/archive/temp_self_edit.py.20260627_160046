import re
from app.core.project_scanner import project_scanner
from app.core.memory_write_validator import check_empty_or_trivial
from app.core.tool_manager import tool_manager
from app.core.memory_tools import memory_log_writer

def strip_prose(original_code):
    modified_code = original_code
    for sentence in re.split(r'\n(?=\S)', modified_code):
        if not check_empty_or_trivial(sentence.strip()):
            break
        modified_code = re.sub(f'^{re.escape(sentence)}', '', modified_code, count=1)
    memory_log_writer.write(f"Modified strip_prose at {datetime.now().isoformat()}. Removed leading natural-language sentences from the original code.", "MODIFICATION")
    return modified_code

def update_strip_prose():
    file_content = project_scanner.load_file('self_edit_generated.py')
    current_code = re.search(r'def strip_prose\([^)]*\):[\s\S]*?\n', file_content, re.MULTILINE).group(0)
    new_code = strip_prose(current_code)
    updated_file_content = re.sub(r'^def strip_prose\([^)]*\):[\s\S]*?\n', f'def strip_prose({{re.escape(new_code)}})\n', file_content, count=1, flags=re.MULTILINE)
    project_scanner.modify_file('self_edit_generated.py', lambda x: updated_file_content)

update_strip_prose()