# import necessary modules
from app.core.self_edit_generated import *
from app.core.memory_bridge import append_to_journal

def modify_main_function(file_path):
    main_function = modify_main_function(file_path)
    sandbox_failure_output = main_function.run_sandbox()
    code_lines = parse_file(sandbox_failure_output, 'python')
    
    updated_code_output = ''
    for line in code_lines:
        prose_removed_line = strip_prose(line)
        if prose_removed_line:
            updated_code_output += prose_removed_line + '\n'
        else:
            updated_code_output += line + '\n'
    
    main_function.modify_file(file_path, updated_code_output)

def strip_prose(line):
    parts = line.split()
    python_tokens = []
    for word in parts:
        if word.lower().startswith(('if', 'else', 'for', 'while', 'def', 'class', 'import', 'from')):
            python_tokens.append(word)
        elif word.isidentifier() or word in ['+', '-', '*', '/', '=', '<', '>', '!', '?', ':']:
            python_tokens.append(word)
        else:
            continue

    if python_tokens:
        return " ".join(python_tokens)
    else:
        return line