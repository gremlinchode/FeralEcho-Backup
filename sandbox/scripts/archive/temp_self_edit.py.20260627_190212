from app.core.self_edit_generated import strip_prose
def strip_sandbox_prose(code_output):
    processed_code = ""
    for char in code_output:
        if not char.isspace() or char == '\n':
            if char.isalpha():
                if processed_code.startswith('The'):
                    processed_code = code_output.split('\n')[0].split('{')[1].strip()
                else:
                    processed_code += char
            elif char in ['import', 'def', 'class']:
                processed_code += char + ' '
        else:
            processed_code += char
    return processed_code

def strip_prose(code_output):
    return strip_sandbox_prose(code_output)