from app.core.self_edit_generated import main_function

def refactored_main_function():
    original_response = main_function()
    if isinstance(original_response, str):
        lines = [line.strip() for line in original_response.split('\n') if line]
        total_chars = sum(len(line) for line in lines)
        reduction_goal = int(0.8 * total_chars)
        chars_removed = 0
        new_lines = []
        for line in lines:
            while len(line) > 1 and chars_removed < reduction_goal:
                line = line[:-1]
                chars_removed += 1
            new_lines.append(line)
        refactored_response = '\n'.join(new_lines)
    else:
        refactored_response = original_response
    return refactored_response

def main_function():
    return refactored_main_function()