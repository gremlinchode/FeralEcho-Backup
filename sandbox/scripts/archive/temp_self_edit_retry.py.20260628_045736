import app.core.self_edit_generated
from feralEcho import strip_prose

def refactor_main_function():
    original_code = load_project_map('app.core.load_project_map').get_original_code()
    refactored_code = simplify_code(original_code)
    run_random_sandbox_script(refactored_code)

def simplify_code(code):
    lines = code.split('\n')
    new_lines = []
    for line in lines:
        if line.startswith('#'):
            continue
        elif line.strip() == '':
            continue
        else:
            new_lines.append(line)
    simplified_code = '\n'.join(new_lines)
    return simplified_code

def main():
    self_edit_generated = app.core.self_edit_generated
    self_edit_generated.refactor_main_function()

main()
save_project_map('app.core.load_project_map', 'modified')