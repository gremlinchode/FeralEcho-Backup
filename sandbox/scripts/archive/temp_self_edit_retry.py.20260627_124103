import re

def strip_prose(text):
    prose_pattern = r'^\s*(?:(?:[A-Za-z\s,\.!?]+)\n)*'
    return re.split(prose_pattern, text)[1]

with open("app/core/self_edit_generated.py", "r") as file:
    file_contents = file.read()

file_contents = strip_prose(file_contents)

from app.core.self_edit_generated import modify_main_function
modify_main_function(file_contents)

with open("app/core/self_edit_generated.py", "w") as file:
    file.write(modify_main_function(file_contents))