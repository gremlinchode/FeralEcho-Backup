# import necessary modules
import app.core.self_edit_generated
import app.core.feral_tools
import re

def strip_prose(code):
    prose_pattern = r'^\s*\S+?(?=\n(\s*#.*)*$)'
    if re.search(prose_pattern, code):
        return re.sub(prose_pattern, '', code)
    else:
        return code

stripped_code = strip_prose(main_function)

main_function = stripped_code

with open('app/core/self_edit_generated.py', 'w') as f:
    f.write(stripped_code)