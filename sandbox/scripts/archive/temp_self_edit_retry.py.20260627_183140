import re

def strip_prose(modified):
    if modified.startswith('” “'):
        return re.sub(r'^<\w+_', '', modified)
    else:
        pattern = r'^<\w+_[a-zA-Z0-9_]+>'
        match = re.search(pattern, modified)
        if match:
            return modified[:match.start()]
        else:
            return modified.strip()