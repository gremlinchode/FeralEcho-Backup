from app.core.self_edit_generated import strip_prose

def autonomous_strip_prose(input_string):
    if re.match(r'\b(Here|This) .*\.', input_string, re.IGNORECASE):
        return re.split(r'(?<=[.!?]) +', input_string)[1].lstrip()
    else:
        return input_string

def strip_prose(input_string):
    return autonomous_strip_prose(input_string)