import re
from app.core.self_edit_generated import strip_prose

def strip_prose_with_guard(text):
    sentence_endings = r'[.!?]'
    match = re.match(f'(.*?{sentence_endings}\s+)', text, re.DOTALL)
    if match:
        return match.group(1).strip()
    return text

strip_prose = lambda x: strip_prose_with_guard(x)

file_content = parse_file('app/core/self_edit_generated.py')

functions_and_classes = detect_functions_and_classes(file_content)

for func_name, code in functions_and_classes:
    if 'run_random_sandbox_script' in func_name:
        lines = code.split('\n')
        for i, line in enumerate(lines):
            if 're.match' in line and 'prose' in line:
                new_line = line.replace(line, f"stripped_text = strip_prose_with_guard(text)\n    {line.strip()}")
                lines[i] = new_line
                break

parse_file('app/core/self_edit_generated.py', '\n'.join(lines))