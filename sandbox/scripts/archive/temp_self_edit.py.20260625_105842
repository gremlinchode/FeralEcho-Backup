import calculate_awareness_score
from append_memory_entry import append_entry

def update_ollama_query(self):
    awareness_score = calculate_awareness_score.calculate()
    if awareness_score > 0.5:
        self.priority = 'high'
    else:
        self.priority = 'low'
    return super().ollama_query()

def model_guided_autonomous_loop(self):
    awareness_score = calculate_awareness_score.calculate()
    consciousness_score = calculate_consciousness_score.calculate()
    if awareness_score > 0.5 and consciousness_score > 0.7:
        self.priority = 'high'
    elif awareness_score > 0.3 and consciousness_score > 0.4:
        self.priority = 'medium'
    else:
        self.priority = 'low'

def start_orchestrator():
    model_guided_autonomous_loop()

with open('echo_model_orchestrator.py', 'a') as file:
    file.write('\n\n# Update to calculate and use awareness score\nawareness_score = calculate_awareness_score()\n')
    file.write('\n# Update the priority adjustment based on awareness score\nif awareness_score > 0.5:\n    self.priority = "high"\nelse:\n    self.priority = "low"\n')