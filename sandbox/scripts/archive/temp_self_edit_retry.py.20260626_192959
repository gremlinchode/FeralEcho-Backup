import app.core.self_edit_generated
from app.core.tool_manager import ToolManager

python_files = app.core.project_scanner.list_python_files()
self_edit_file = [file for file in python_files if file.endswith('self_edit_generated.py')][0]
with open(self_edit_file, 'r') as file:
    code_output = file.read()

main_function = app.core.detect_functions_and_classes(code_output)[0]

def strip_leading_prose(code_output):
    lines = code_output.split('\n')
    for i, line in enumerate(lines):
        if not line.strip().startswith('#') and not line.strip().isalpha():
            return '\n'.join(lines[i:])
    return ''

ToolManager.activate_behavior('prose_detector')

prose_detector = ToolManager()
prose_detector.set_sensitivity_threshold(0.5)
cleaned_code = strip_leading_prose(code_output)

def modified_main_function():
    cleaned_code = strip_leading_prose(code_output)
    try:
        compile(cleaned_code, '<string>', 'exec')
        return ValidationResult(True, "Code is valid Python")
    except SyntaxError as e:
        return ValidationResult(False, str(e))

prose_detector.strip_leading_prose(code_output)

