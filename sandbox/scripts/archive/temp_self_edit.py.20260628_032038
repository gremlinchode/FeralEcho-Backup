import app.core.self_edit_generated
from FeralEcho import detect_functions_and_classes
import re

def prose_strip(code):
    match = re.search(r'^\s*\w*(?:\.\n|\?\n|!\n).*$', code)
    if match:
        stripped_code = code[match.end():]
        if not any(stripped_code.lstrip().startswith(s) for s in ['def ', 'class ', '#']):
            raise SyntaxError('No Python tokens found after stripping')
        return stripped_code
    else:
        return code

app.core.self_edit_generated.strip_prose = lambda code: prose_strip(code).lstrip()