{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "feralecho-cross-backup-relay-message/1.0",
 "title": "FeralEcho cross-backup relay message (parsed form)",
 "description": "DESIGN ARTIFACT, 2026-09-20. The parsed key/value form of one operator-relayed message between CLAUDE-M5 and CLAUDE-INTEL. Text form: banner line 'FERALECHO CROSS-BACKUP RELAY v1', 'KEY: value' lines, 'MSG_CRC: <8 hex>' (first 8 hex of sha256 over every preceding line, newline-terminated), 'END RELAY'. Secrets never appear in any field (ENV_FILE is restricted to PRESENT/ABSENT + size/mode/16-hex hash prefix). Every example in the plan was rendered, sealed, checked with relay_check and validated against this schema. x-transitions lists the only permitted step successors; ABORT is permitted from any step; the human-authorization gate is the absence of any edge from TRANSFER_AUTHORIZATION_REQUIRED to TRANSFER_COMPLETE_SOURCE.",
 "type": "object",
 "required": [
  "MACHINE",
  "LINEAGE",
  "MACHINE_ID16",
  "TO",
  "SEQ",
  "REPLY_TO",
  "STEP",
  "DIRECTION",
  "GEN",
  "GIT_HEAD",
  "WORKTREE",
  "FERALECHO_ROOT",
  "SERVER",
  "BACKUP_STATUS",
  "STATUS",
  "NOTES",
  "MSG_CRC"
 ],
 "properties": {
  "MACHINE": {
   "enum": [
    "M5",
    "INTEL"
   ],
   "type": "string"
  },
  "LINEAGE": {
   "enum": [
    "FERALECHO-M5",
    "FERALECHO-INTEL-2020"
   ],
   "type": "string"
  },
  "MACHINE_ID16": {
   "pattern": "^[0-9a-f]{16}$",
   "type": "string"
  },
  "TO": {
   "enum": [
    "M5",
    "INTEL",
    "OPERATOR"
   ],
   "type": "string"
  },
  "SEQ": {
   "pattern": "^[0-9]+$",
   "type": "string"
  },
  "REPLY_TO": {
   "pattern": "^(NONE|[0-9]+)$",
   "type": "string"
  },
  "STEP": {
   "enum": [
    "DISCOVERY_REQUEST",
    "DISCOVERY_RESPONSE",
    "DIRECTION_PROPOSAL",
    "SOURCE_MANIFEST_OFFER",
    "DESTINATION_CAPACITY_ACCEPT",
    "TRANSFER_PLAN",
    "TRANSFER_AUTHORIZATION_REQUIRED",
    "AUTHORIZATION_ACK",
    "TRANSFER_COMPLETE_SOURCE",
    "TRANSFER_COMPLETE_DESTINATION",
    "HASH_CHALLENGE",
    "HASH_CONFIRM",
    "HASH_VERDICT",
    "STRUCTURAL_VALIDATION",
    "GENERATION_SEALED",
    "SECOND_DIRECTION_READY",
    "ABORT"
   ],
   "type": "string"
  },
  "DIRECTION": {
   "enum": [
    "NONE",
    "M5->INTEL",
    "INTEL->M5"
   ],
   "type": "string"
  },
  "GEN": {
   "pattern": "^(NONE|(M5|INTEL)_[0-9]{4}-[0-9]{2}-[0-9]{2}_G[0-9]{3})$",
   "type": "string"
  },
  "GIT_HEAD": {
   "pattern": "^([0-9a-f]{40}|NONE|UNKNOWN)$",
   "type": "string"
  },
  "WORKTREE": {
   "pattern": "^(CLEAN|DIRTY m=[0-9]+ u=[0-9]+|NOT_A_REPO|UNKNOWN)$",
   "type": "string"
  },
  "FERALECHO_ROOT": {
   "type": "string",
   "maxLength": 300
  },
  "SERVER": {
   "pattern": "^(RUNNING pid=[0-9]+ start=\\S+|STOPPED|UNKNOWN)$",
   "type": "string"
  },
  "BACKUP_STATUS": {
   "type": "string",
   "maxLength": 300
  },
  "STATUS": {
   "enum": [
    "READY",
    "BLOCKED",
    "INFO",
    "ERROR"
   ],
   "type": "string"
  },
  "NOTES": {
   "type": "string",
   "maxLength": 300
  },
  "MSG_CRC": {
   "pattern": "^[0-9a-f]{8}$",
   "type": "string"
  },
  "ENV_FILE": {
   "pattern": "^(ABSENT|PRESENT size=[0-9]+ mode=[0-7]+ sha256_16=[0-9a-f]{16})$",
   "type": "string"
  },
  "DEST_PATH": {
   "pattern": "^/Users/[A-Za-z0-9._-]+/FeralEcho_Cross_Backups/FROM_(M5|INTEL)/(M5|INTEL)_[0-9]{4}-[0-9]{2}-[0-9]{2}_G[0-9]{3}$",
   "type": "string"
  },
  "SRC_LOCAL_GEN_PATH": {
   "pattern": "^/Users/[A-Za-z0-9._-]+/FeralEcho_Cross_Backups/OWN_LOCAL/(M5|INTEL)_[0-9]{4}-[0-9]{2}-[0-9]{2}_G[0-9]{3}$",
   "type": "string"
  },
  "CONSISTENCY_LEVEL": {
   "enum": [
    "RESCUE-LIVE",
    "VERIFIED-LIVE",
    "VERIFIED-QUIESCENT",
    "QUARANTINED"
   ],
   "type": "string"
  },
  "VERDICT": {
   "enum": [
    "MATCH",
    "MISMATCH"
   ],
   "type": "string"
  },
  "DECISION": {
   "enum": [
    "ACCEPT",
    "REJECT"
   ],
   "type": "string"
  },
  "TOPOLOGY": {
   "enum": [
    "SOURCE_PUSHES",
    "DESTINATION_PULLS"
   ],
   "type": "string"
  },
  "NONCE": {
   "pattern": "^[0-9a-f]{8,32}$",
   "type": "string"
  },
  "ARCH_TRUE": {
   "enum": [
    "arm64",
    "x86_64"
   ],
   "type": "string"
  },
  "WORKTREE_FINGERPRINT": {
   "pattern": "^[0-9a-f]{64}$",
   "type": "string"
  },
  "SOURCE_LIST_HASH": {
   "pattern": "^[0-9a-f]{64}$",
   "type": "string"
  },
  "SOURCE_MANIFEST_HASH": {
   "pattern": "^[0-9a-f]{64}$",
   "type": "string"
  },
  "DEST_MANIFEST_HASH_SEEN": {
   "pattern": "^[0-9a-f]{64}$",
   "type": "string"
  },
  "DEST_MANIFEST_HASH": {
   "pattern": "^[0-9a-f]{64}$",
   "type": "string"
  },
  "REPORT_HASH": {
   "pattern": "^[0-9a-f]{64}$",
   "type": "string"
  },
  "TOOLS_HASH": {
   "pattern": "^[0-9a-f]{64}$",
   "type": "string"
  },
  "TRANSFER_PLAN_HASH": {
   "pattern": "^[0-9a-f]{64}$",
   "type": "string"
  },
  "VALIDATION_HASH": {
   "pattern": "^[0-9a-f]{64}$",
   "type": "string"
  },
  "DEST_SEAL_HASH": {
   "pattern": "^[0-9a-f]{64}$",
   "type": "string"
  },
  "REGISTRY_LINE_HASH": {
   "pattern": "^[0-9a-f]{64}$",
   "type": "string"
  },
  "SCRIPT_SHA256": {
   "pattern": "^[0-9a-f]{64}$",
   "type": "string"
  },
  "D1": {
   "pattern": "^[0-9a-f]{64}$",
   "type": "string"
  },
  "D2": {
   "pattern": "^[0-9a-f]{64}$",
   "type": "string"
  },
  "D3": {
   "pattern": "^[0-9a-f]{64}$",
   "type": "string"
  },
  "D4": {
   "pattern": "^[0-9a-f]{64}$",
   "type": "string"
  },
  "STATE_LAYOUT_FP": {
   "pattern": "^[0-9a-f]{16}$",
   "type": "string"
  },
  "HW_ID16": {
   "pattern": "^[0-9a-f]{16}$",
   "type": "string"
  },
  "PHRASE_SHA16": {
   "pattern": "^[0-9a-f]{16}$",
   "type": "string"
  },
  "AUTH_PHRASE_SHA16": {
   "pattern": "^[0-9a-f]{16}$",
   "type": "string"
  },
  "REPO_BYTES": {
   "pattern": "^[0-9]+$",
   "type": "string"
  },
  "GITDIR_BYTES": {
   "pattern": "^[0-9]+$",
   "type": "string"
  },
  "MEMORY_BYTES": {
   "pattern": "^[0-9]+$",
   "type": "string"
  },
  "DATA_BYTES": {
   "pattern": "^[0-9]+$",
   "type": "string"
  },
  "SOURCE_BYTES": {
   "pattern": "^[0-9]+$",
   "type": "string"
  },
  "STATE_BYTES": {
   "pattern": "^[0-9]+$",
   "type": "string"
  },
  "PROPOSED_BACKUP_BYTES": {
   "pattern": "^[0-9]+$",
   "type": "string"
  },
  "HOME_FREE_BYTES": {
   "pattern": "^[0-9]+$",
   "type": "string"
  },
  "HOME_TOTAL_BYTES": {
   "pattern": "^[0-9]+$",
   "type": "string"
  },
  "FILE_COUNT": {
   "pattern": "^[0-9]+$",
   "type": "string"
  },
  "BYTE_COUNT": {
   "pattern": "^[0-9]+$",
   "type": "string"
  },
  "FILE_COUNT_EST": {
   "pattern": "^[0-9]+$",
   "type": "string"
  },
  "BYTE_COUNT_EST": {
   "pattern": "^[0-9]+$",
   "type": "string"
  },
  "SOURCE_PART_BYTES": {
   "pattern": "^[0-9]+$",
   "type": "string"
  },
  "STATE_PART_BYTES": {
   "pattern": "^[0-9]+$",
   "type": "string"
  },
  "REQUIRED_FREE_BYTES": {
   "pattern": "^[0-9]+$",
   "type": "string"
  },
  "FREE_DEST_BYTES": {
   "pattern": "^[0-9]+$",
   "type": "string"
  },
  "VOLUME_TOTAL_BYTES": {
   "pattern": "^[0-9]+$",
   "type": "string"
  },
  "POST_TRANSFER_FREE_BYTES": {
   "pattern": "^[0-9]+$",
   "type": "string"
  },
  "EXPECTED_FILE_COUNT": {
   "pattern": "^[0-9]+$",
   "type": "string"
  },
  "EXPECTED_BYTE_COUNT": {
