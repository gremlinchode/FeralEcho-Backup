# import re

def strip_prose_to_python_token():
    output_text = ""
    
    while True:
        try:
            line = next(open("self_edit_generated.py"))
            if re.search(r'\b(a|an|the)\s+(is|are|am|be|been|being|was|were)\b', line):
                line = line[:line.find(":") or line.find("=")].strip()
                output_text += line
            else:
                break
        except StopIteration:
            break
    
    return output_text