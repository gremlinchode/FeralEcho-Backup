import re
from app.core.self_edit_generated import original_code

with open('app/core/self_edit_generated.py', 'r') as f:
    code = f.read()

prose_pattern = re.compile(r'^\S+\s*\(.+$')

for line in code.splitlines():
    if re.search(prose_pattern, line):
        parts = line.split()
        code_part = parts[1:] if len(parts) > 1 else []
        truncated_line = ' '.join(code_part).strip()
    else:
        truncated_line = line

with open('app/core/self_edit_generated.py', 'w') as f:
    f.write('\n'.join(line.startswith("#") or line.strip() for line in [truncated_line] + code.splitlines()[1:]))
f.close()