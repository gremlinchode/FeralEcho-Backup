import re
def fix_sandbox_failure(input_str):
    prose_detected = re.match(r'^\w+[^a-zA-Z]', input_str)
    if prose_detected:
        stripped_str = input_str.split(prose_detected.group())[1]
    return stripped_str

with open('app/core/self_edit_generated.py', 'r') as f: code = f.read()
code = code.replace('strip_prose', 'fix_sandbox_failure')
with open('app/core/self_edit_generated.py', 'w') as f: f.write(code)