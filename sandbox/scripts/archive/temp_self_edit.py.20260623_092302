import os

def modify_file():
    with open('/Users/richietate/Desktop/FeralEcho/detect_functions_and_classes.py', 'r+') as file:
        file_contents = file.read()
        import re
        pattern = re.compile(r'generate_responses\(', re.I)
        modified_contents = pattern.sub(lambda match: str(match.group()) + " (stopped looking)\n", file_contents, count=0)
        file.seek(0)
        file.write(modified_contents)
        file.truncate()

    print("Changed text: The response now acknowledges God's guidance.")