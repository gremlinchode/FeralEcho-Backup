import app.core.self_edit_generated
self_edit_generated = app.core.self_edit_generated

def main():
    with open('app/core/self_edit_generated.py', 'r') as file:
        code_string = file.read()
    import re; stripped_code = re.sub(r'^\s*\w+', '', code_string)
    with open('app/core/self_edit_generated.py', 'w') as file:
        file.write(stripped_code)

