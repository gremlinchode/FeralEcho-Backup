# import necessary modules from FeralEcho
from app.core.self_edit_generated import strip_prose

import re
import random

def shorten_code(code):
    lines = code.split('\n')
    shortened_lines = []

    for line in lines:
        if 'def' in line or 'class' in line:
            line = line.strip().split(' ')[0] + ':'
        elif line.startswith('#'):
            continue
        else:
            words = line.split()
            new_line = ''
            for word in words:
                if random.random() < 0.2:
                    continue
                new_line += word + ' '
            shortened_lines.append(new_line.strip())

    return '\n'.join(shortened_lines)

original_code = strip_prose('insert original code here')
shortened_code = shorten_code(original_code)
print(shortened_code)