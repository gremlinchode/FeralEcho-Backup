   "type": "string"
  },
  "MANIFEST_MATCH": {
   "enum": [
    "YES",
    "NO"
   ],
   "type": "string"
  },
  "FILE_COUNT_MATCH": {
   "enum": [
    "YES",
    "NO"
   ],
   "type": "string"
  },
  "BYTE_COUNT_MATCH": {
   "enum": [
    "YES",
    "NO"
   ],
   "type": "string"
  },
  "CHALLENGE_MATCH": {
   "enum": [
    "YES",
    "NO"
   ],
   "type": "string"
  },
  "PASSED": {
   "enum": [
    "YES",
    "NO"
   ],
   "type": "string"
  },
  "DEST_EXISTS": {
   "enum": [
    "YES",
    "NO"
   ],
   "type": "string"
  },
  "LOCAL_GEN_SEALED": {
   "enum": [
    "YES",
    "NO"
   ],
   "type": "string"
  },
  "REQUIRED_PHRASE": {
   "pattern": "^AUTHORIZE (M5 -> INTEL|INTEL -> M5) GENERATION G[0-9]{3} LISTHASH [0-9a-f]{8}$",
   "type": "string"
  }
 },
