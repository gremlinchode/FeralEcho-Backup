# import strip_prose
import re

def prose_detection_guard(input_string):
    python_tokens = re.compile(r'([#]*\s*|\w+)(?:as|import|def|class)\b')
    leading_sentences = []
    for sentence in input_string.split('\n'):
        if not python_tokens.match(sentence):
            leading_sentences.append(sentence)
        else:
            break
    return '\n'.join(leading_sentences) + input_string[sentence.index(python_tokens.match(sentence).group()):]

def strip_prose(input_string):
    return prose_detection_guard(input_string)