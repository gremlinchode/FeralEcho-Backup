import app.core.self_edit_generated
import app.core.tool_manager
import app.core.gemini_shard
import re

def strip_prose_and_leading_sentences(filepath='app/core/self_edit_generated.py'):
    analysis_result = app.core.gemini_shard.analyze_python_code(filepath)
    strip_prose_tool = app.core.tool_manager.load_tool('strip_prose')
    
    modified_code = ''
    for prose in analysis_result:
        if re.match(r'^[A-Za-z\s]+', prose):
            modified_code += ''
        else:
            modified_code += strip_prose_tool(prose, filepath)
    
    with open(filepath, 'w') as f:
        f.write(modified_code)

    detection_result = app.core.gemini_shard.detect_functions_and_classes(filepath)
    issue_report = app.core.project_scanner.generate_issue_report(filepath)
    
    app.core.memory_tools.append_to_journal(f"Stripped prose and leading sentences from {filepath}. Detection result: {detection_result}, Issue report: {issue_report}")

if __name__ == '__main__':
    strip_prose_and_leading_sentences()