import re

def strip_prose(text):
    while True:
        match = re.search(r"^\s*(.*?)\s*#", text, re.MULTILINE)
        if not match:
            break
        text = text[match.end():]
    return text

def modified_main_function(input_text):
    prose_removed = False
    original_text = input_text
    input_text = strip_prose(input_text)
    if input_text != original_text:
        prose_removed = True

    if prose_removed:
        print(f"Prose detected and removed. Original text: {original_text}\nModified text: {input_text}")
        # Standard code execution steps would go here
        pass
    else:
        print("No prose detected.")

