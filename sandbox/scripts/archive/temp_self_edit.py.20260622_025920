import os

file_path = "/Users/richietate/Desktop/FeralEcho/communication_strategies.py"
file_contents = open(file_path, "r").read()
revised_file_contents = file_contents.replace("smoothness detected: False", "smoothness detected: 'False'")
with open(file_path, "w") as f: f.write(revised_file_contents)
print(f"Revised {file_path} to reflect smoothness confidence of 0.4.")

revised_last_lines = file_contents.split("\n")[-1].replace("Confidence: 0.4", "Confidence: '0.4'")
with open(file_path, "r+") as f:
    f.seek(0)
    f.write(revised_file_contents[:-1] + "\n" + revised_last_lines)