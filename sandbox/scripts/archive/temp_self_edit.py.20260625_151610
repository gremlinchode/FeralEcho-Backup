# import necessary tools
from echo_model_orchestrator import ollama_query
import ast
import parse_file
import model_guided_autonomous_loop

def register_ollama_query():
    parsed_file = ast.parse(open('echo_model_orchestrator.py', 'r').read())
    for node in parsed_file.body:
        if isinstance(node, ast.FunctionDef) and node.name == 'ollama_query':
            ollama_def = node
            break
    def new_ollama_query():
        return ollama_def
    return new_ollama_query

model_guided_autonomous_loop.register_function(register_ollama_query())

def start_orchestrator():
    return ollama_query()

def generate_issue_report():
    result = model_guided_autonomous_loop.ollama_query()
    return result