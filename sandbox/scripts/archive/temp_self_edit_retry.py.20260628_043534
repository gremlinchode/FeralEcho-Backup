import app.core.self_edit_generated
import logging

self_edit_generated.strip_prose = lambda x: strip_prose(x)

def strip_prose(code):
    if code.startswith("prose detected in code output"):
        return code.split("try/except block not found")[1]
    else:
        return code

test_code = "prose detected in code output some random code"
