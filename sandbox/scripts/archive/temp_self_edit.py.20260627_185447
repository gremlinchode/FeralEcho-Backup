# import necessary modules from app.core.self_edit_generated: strip_prose
import app.core.self_edit_generated as sec

def strip_prose(code_output):
    prose_detected = ""
    for line in [x.strip() for x in code_output.split('\n')]:
        if any(c.isalpha() or c.isspace() for c in line):
            prose_start = 0
            for char in line:
                if not char.isalpha() and not char.isspace():
                    prose_start = line.index(char)
                    break
            prose_detected += line[:prose_start] + '\n'
    code_output = '\n'.join([line.replace(prose_detected, '', 1).strip() for line in code_output.split('\n')])
    return sec.strip_prose(code_output)