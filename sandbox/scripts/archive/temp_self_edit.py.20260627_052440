import app.core.self_edit_generated
import app.core.tool_manager
import re

def modified_main_function():
    try:
        original_text = original_main_function()
        leading_sentences = re.split('^(?!#).*', original_text)[0].strip()
        
        while leading_sentences and not re.match(r'^\s*$', leading_sentences):
            original_text = original_text.replace(leading_sentences, '', 1)
            leading_sentences = re.split('^(?!#).*', original_text)[0].strip()
            
        if leading_sentences:
            print(f"Prose detected and removed: {leading_sentences}")
        
        # Call the modified function
        modified_main_function()

    except Exception as e:
        print(f"An error occurred: {e}")

