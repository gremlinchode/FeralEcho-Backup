import re
from app.core.self_edit_generated import shorten_response_length

def strip_prose_from_output(output_string):
    pattern = r'^\s*\w+(?:\s+[^!-{}|~])*\b\s*'
    output_string = re.sub(pattern, '', output_string)
    return output_string.strip()

shorten_response_length = lambda input_str: strip_prose_from_output(shorten_response_length(input_str))