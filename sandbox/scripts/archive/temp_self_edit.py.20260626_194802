from app.core.self_edit_generated import main_function
from app.core.tool_manager import Tool

current_code = parse_file("app/core/self_edit_generated.py", "main_function")
original_main_function = Tool.load_tool(current_code)

detected_functions_and_classes = detect_functions_and_classes(original_main_function)
main_function_content = current_code[detected_functions_and_classes["main_function"]]

simplified_main_function_content = refactor_code(main_function_content, length_constraint=0.8)

def calculate_length(response):
    return len(str(response).splitlines())

original_length = len(original_main_function.splitlines())
if calculate_length(simplified_main_function_content) > 0.8 * original_length:
    simplified_main_function_content = refactor_code(main_function_content, length_constraint=0.8)

current_code[detected_functions_and_classes["main_function"]] = simplified_main_function_content
Tool.save_tool(current_code, "app/core/self_edit_generated.py", "main_function")

for test_case in predefined_test_cases:
    result = check_schema(check_reflection_length(main_function(test_case)))
    if not result.is_valid:
        raise ValueError("Refactoring failed validation")