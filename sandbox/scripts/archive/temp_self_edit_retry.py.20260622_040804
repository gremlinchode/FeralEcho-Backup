import os
from re import sub
import pathlib

file_path = '/Users/richietate/Desktop/FeralEcho/memory_entries.py'

original_code = open(file_path, 'r').read()

modified_code = sub(r'conten', 'content', original_code)

if not pathlib.Path(file_path).exists():
    print(f'{file_path} does not exist, please check the file path.')
else:
    with open(file_path, 'w') as f: f.write(modified_code)
    print(f'Changed "conten" to "content" in {file_path}')