    for line in original_code.split('\n'):
        if len(truncated_code) * 1.2 < len(line):
            continue
        truncated_code += line.replace(' ', '')[:len(line)-len(line)//5] + '\n'
    
    quality_score = Tool.cyclomatic_complexity(truncated_code)
    
    is_valid = check_schema(truncated_code)
    if not is_valid:
        logging.error("Code deviation from syntax and structure rules detected!")
    
    if is_valid:
