from app.core.self_edit_generated import *
from app.core.tool_manager import *

def score_code_string(code_string):
    if parse_file(code_string)['imports']:
        return 1
    else:
        return 0
    
    functions_detected = detect_functions_and_classes(code_string)
    if functions_detected:
        return 1
    else:
        return 0
    
    prose_found = parse_file(code_string)['prose']
    if prose_found:
        return 1
    else:
        return 0
    
    quality_score = sum([0, 0, 0])
    return quality_score