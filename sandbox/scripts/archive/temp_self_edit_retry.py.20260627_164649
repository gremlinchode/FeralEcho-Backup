# import necessary modules and functions
from app.core.self_edit_generated import strip_prose
import re
importlib

# load the current self-edit generated module from `app.core.self_edit_generated`
module_name = 'self_edit_generated'
try:
    self_edit_generated = importlib.import_module(module_name)
except ImportError as e:
    print(f"Error importing {module_name}: {e}")
    return

# open `app/core/self_edit_generated.py` in read mode
file_path = 'app/core/self_edit_generated.py'
with open(file_path, 'r') as f:
    content = f.read()

# use regular expressions to detect any leading natural-language sentence before the first valid Python token and strip it off if found
match = re.search(r'^.*?\n?(\s*)#+\s*', content, re.MULTILINE)
if match:
    content = content[len(match.group(1)):]

# save the modified content back into the original file, replacing the existing contents
with open(file_path, 'w') as f:
    f.write(content)

# reload the self-edit generated module with the updated code
importlib.reload(self_edit_generated)