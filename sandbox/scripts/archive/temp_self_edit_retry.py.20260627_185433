from app.core.self_edit_generated import strip_prose
original_strip_prose = strip_prose

def new_strip_prose(input_code):
    for line in input_code.splitlines():
        if not any(line.lower().startswith(s) for s in ['if', 'class', 'def']):
            return None
        for sentence in line.split('.'):
            if any(sentence.strip().lower().endswith('the very first character of your response must') and any(char.isalpha() for char in sentence)):
                return None
    return original_strip_prose(input_code)