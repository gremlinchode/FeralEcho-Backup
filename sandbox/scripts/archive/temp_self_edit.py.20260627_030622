from app.core.self_edit_generated import main_function
import time

def measure_response_length(func, num_runs=10):
    total_length = 0
    for _ in range(num_runs):
        start_time = time.time()
        result = func()
        end_time = time.time()
        response_length = len(str(result))  
        total_length += response_length
        print(f"Run {_ + 1}: Response Length = {response_length}, Time = {end_time - start_time:.4f}s")
    return total_length / num_runs

def refactor_main_function():
    original_code = main_function
    simplified_code = simplify_and_optimize(original_code)
    return simplified_code

def correctness_check(func, test_inputs):
    for input_data in test_inputs:
        try:
            result = func(input_data)
            if not result == "Correct Output":
                print(f"Error for input {input_data}: Expected 'Correct Output', got '{result}'")
        except Exception as e:
            print(f"Exception occurred during correctness check for input {input_data}: {e}")

def optimize_main_function(target_reduction=0.2):
    original_length = measure_response_length(main_function)
    modified_result = refactor_main_function()
    new_length = measure_response_length(modified_result)

    reduction_percentage = (original_length - new_length) / original_length * 100
    print(f"Original Average Length: {original_length}, New Average Length: {new_length}, Reduction: {reduction_percentage:.2f}%")

    if reduction_percentage < target_reduction:
        print("Optimization not successful, attempting further refinement...")
        return modified_result
    else:
        return modified_result

def finalize_main_function(optimized_func):
    code = str(optimized_func)
    stripped_code = code.replace("#", "").strip()
    print("Version Control Commit Marker: Add this to your VCS...")  
    return stripped_code

