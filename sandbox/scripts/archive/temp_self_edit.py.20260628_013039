from app.core.self_edit_generated import strip_prose 

def shorten_code(code): 
    lines = code.split('\n') 
    new_lines = [] 
    for line in lines: 
        if "//" in line or "#" in line: 
            continue 
        if not line.strip(): 
            continue 
        if "import" in line: 
            continue 
        if 'class' in line: 
            continue 
        new_lines.append(line.replace(' ', '')) 
    return '\n'.join(new_lines)[:int(len(new_lines) * 0.8)]

def replace_code_generation(original_code): 
    original_code = strip_prose(original_code) 
    shortened_code = shorten_code(original_code) 
    return shortened_code