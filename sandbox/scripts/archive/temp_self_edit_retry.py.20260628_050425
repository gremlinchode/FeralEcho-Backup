def run_random_sandbox_script(sandbox_script, *, output=None):
    try:
        import language_detection
    except ImportError:
        print("Error importing language detection module")
        return None
    
    if output and language_detection.detect_language(output)['language'] != 'Code':
        output = strip_prose(output)
    
    if output:
        try:
            exec(sandbox_script)
        except Exception as e:
            print(f"Error executing script: {e}")
            return None
        
        return output
    else:
        run_sandbox_script(sandbox_script)