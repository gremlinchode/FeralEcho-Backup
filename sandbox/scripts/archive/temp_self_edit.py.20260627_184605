from app.core.self_edit_generated import strip_prose
import os
import re
import datetime
def modify_strip_prose():
    with open('app/core/self_edit_generated.py', 'r') as file:
        content = file.read()
    pattern = r'([a-zA-Z0-9_]+[.])\s*'
    match = re.search(pattern, content)
    if match:
        content = re.sub(r'^.*?(?=('+match.group(1)+'))', '', content, flags=re.MULTILINE)
        with open('app/core/self_edit_generated.py', 'w') as file:
            file.write(content)
    log_entry = f"Modified strip_prose function on {os.getcwd()} at {datetime.datetime.now().isoformat()}\n"
    with open('log.txt', 'a') as file:
        file.write(log_entry)