# import necessary modules
from app.core.self_edit_generated import *

def score_code_quality(candidate_code: str) -> int:
    has_imports = False
    has_function_def = False
    no_prose_sentences = False
    
    lines = candidate_code.split('\n')
    
    for line in lines:
        if 'import' in line:
            has_imports = True
        elif line.lstrip().startswith('def'):
            has_function_def = True
        elif not line.strip().startswith('"') and not line.strip().endswith('"'):
            no_prose_sentences = True
    
    quality_score = int((has_imports + has_function_def + no_prose_sentences) / 3)
    
    return quality_score