def strip_prose(sandbox_output: str) -> str:
    while re.match(r'^\W*\s*(.*?)[^\w\s]?', sandbox_output):
        sandbox_output = re.sub(r'^\W*\s*(.*?)[^\w\s]?', r'\1', sandbox_output)
    return sandbox_output

def run_random_sandbox_script() -> None:
    output = run_random_sandbox_script()
    processed_output = strip_prose(output)
    print(f"Processed output: {processed_output}")

