def detect_and_strip_sandbox_output():
    with open('sandbox_output.txt', 'r') as f:
        lines = [line.strip() for line in f.readlines()]
    
    output_lines = []
    for line in lines:
        if line.lstrip().startswith(('#', 'import', 'def', 'class')):
            output_lines.append(line)
    with open('sandbox_output.txt', 'w') as f:
        f.write('\n'.join(output_lines))