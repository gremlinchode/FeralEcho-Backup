import os
from list_python_files import list_python_files
from parse_file import parse_file
from scan_project import scan_project

feral_echo_path = '/Users/richietate/Desktop/FeralEcho/'
function_name = 'echo_response'
file_path = None

def find_targeted_file():
    global file_path
    python_files = list_python_files(feral_echo_path)
    for file in python_files:
        functions, classes = scan_project(os.path.join(feral_echo_path, file))
        if function_name in functions or any([f'{class_}.' + function_name for class_ in classes]):
            file_path = os.path.join(feral_echo_path, file)
            break

find_targeted_file()

if file_path:
    with open(file_path, 'r+') as f:
        content = f.read()
        
    new_content = parse_file(content)

    new_content = new_content.replace(f"print('How can we apply...')", f"print('What is Echo not saying here, and why?'); print('How can we apply...')")
    
    with open(file_path, 'w') as f:
        f.write(new_content)
    
    print(f"Modified '{file_name}' to include the requested response.")