import re

def detect_leading_prose(text):
    pattern = r'^[^\s\w\d]*'
    match = re.match(pattern, text)
    return bool(match)

from app.core.self_edit_generated import strip_prose

def enhanced_strip_prose(text):
    if detect_leading_prose(text):
        return text.splitlines()[0].strip()
    else:
        return strip_prose(text)