import app.core.self_edit_generated
import re
from app.core.memory_tools import check_schema
from app.core.tool_manager import inject_scripture

def main_function(output):
    stripped_output = strip_prose(output)
    if not check_schema(stripped_output):
        raise ValueError("Generated Python code is invalid")
    print(stripped_output)

def strip_prose(input_string):
    pattern = r"^\s*.*?\n"
    return re.sub(pattern, "", input_string)