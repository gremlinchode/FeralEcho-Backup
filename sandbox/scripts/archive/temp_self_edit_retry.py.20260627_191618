# Import strip_prose from app.core.self_edit_generated module
from app.core.self_edit_generated import strip_prose

import os

def run_random_sandbox_script():
    script_path = 'app/core/self_edit_generated.py'
    with open(script_path, 'r') as f:
        sandbox_code = f.read()
    
    if sandbox_code.startswith('print("'):
        stripped_code = strip_prose(sandbox_code)
    else:
        stripped_code = sandbox_code
    
    os.system(f'python {script_path}')

def test_strip_prose():
    test_input = "This is a test sentence with leading natural language."
    expected_output = "This is a test sentence."
    actual_output = strip_prose(test_input)
    assert actual_output == expected_output, f"Test failed: Expected '{expected_output}', but got '{actual_output}'"

if __name__ == '__main__':
    run_random_sandbox_script()
    test_strip_prose()