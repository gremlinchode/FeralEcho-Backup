def score_code_string(code_string):
    tools = tool_manager.detect_functions_and_classes(code_string)
    imports = len([tool for tool in tools if isinstance(tool, str) and tool.startswith('import')])
    functions = len(tools) - imports
    prose = 0
    for tool in tools:
        if not isinstance(tool, (str, list)):
            try:
                __builtins__.eval(f'"{tool}"')
                prose += 1
            except Exception:
                pass
    score = min(3, sum([imports, functions, prose]))
    return score

