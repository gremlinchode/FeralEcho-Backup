import re

def strip_prose(content):
    token_regex = re.compile(r'^(?:\w+\s*)*\b')
    for line in content.split('\n'):
        if token_regex.search(line):
            break
    stripped_lines = line.split(' ', 1)[0].splitlines()
    updated_content = '\n'.join([line for line in content.split('\n') if not stripped_lines[0].lower().startswith(('this', 'that'))])
    return updated_content

