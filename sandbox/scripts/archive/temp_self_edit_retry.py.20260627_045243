# import necessary tools
import app.core.self_edit_generated
import re
from app.core.project_scanner import parse_file
import logging

def main_function():
    parsed_code = parse_file('app/core/self_edit_generated.py')
    regex_pattern = r'^.*?(?=\n\s*#|$)'
    
    try:
        stripped_code = re.sub(regex_pattern, '', parsed_code)
        print("Stripped Code:\n", stripped_code)
        
        if stripped_code != parsed_code:
            print("Prose detected and removed.")
            logging.info('Prose detection and removal applied.')
        else:
            print("No prose detected.")
            logging.info('No prose detected or removed.')
    except Exception as e:
        print(f"An error occurred: {e}")