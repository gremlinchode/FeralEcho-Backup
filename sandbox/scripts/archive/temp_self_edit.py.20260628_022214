import strip_prose
from re import search, sub

def strip_leading_prose(code_output):
    if search(r'\b(?:[A-Za-z ]+)\b', code_output, re.I) and not search(r'import|class|def', code_output, re.I):
        code_output = sub(r'^\s*(?:[A-Za-z ]+\n?)?$', '', code_output, flags=re.M)
    return code_output

code_output = strip_leading_prose(code_output)
code_output