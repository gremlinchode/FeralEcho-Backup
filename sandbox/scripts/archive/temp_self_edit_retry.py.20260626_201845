import app.core.self_edit_generated

def main_function():
    for file in list_python_files():
        parse_file(file)
        detect_functions_and_classes()
        scan_project()
        generate_issue_report()

    import re
    cleaned_code = re.sub(r'#.*?\n', '', code).replace('\s+', ' ').strip()
    new_lines = []
    for line in cleaned_code.split('\n'):
        if len(line) > 80:
            parts = line.split(' ')
            temp_line = ''
            for part in parts:
                if len(temp_line) + len(part) < 80:
                    temp_line += part + ' '
                else:
                    new_lines.append(temp_line.strip())
                    temp_line = part + ' '
            new_lines.append(temp_line.strip())
        else:
            new_lines.append(line)
    code = '\n'.join(new_lines)

    organized_calls_code = []
    current_chunk = []
    for line in code.split('\n'):
        if 'function_call' in line:
            current_chunk.append(line)
        else:
            if current_chunk:
                organized_calls_code.extend(sorted(current_chunk, key=lambda x: len(x)))
                current_chunk = []
            organized_calls_code.append(line)
    if current_chunk:
        organized_calls_code.extend(sorted(current_chunk, key=lambda x: len(x)))

    return '\n'.join(organized_calls_code)