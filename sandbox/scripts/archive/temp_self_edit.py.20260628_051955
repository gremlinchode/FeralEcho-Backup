import re

from app.core.self_edit_generated import strip_prose

def __init__(self):
    self.strip_prose(strip_python_code(""))

def strip_prose(input_string):
    pattern = re.compile(r"^[^a-zA-Z0-9#().]+$")
    if pattern.match(input_string):
        return input_string
    else:
        first_token_index = 0
        for i in range(len(input_string)):
            if input_string[i].lower() in ["def", "class", "if", "elif", "else"]:
                first_token_index = i
                break
        return input_string[:first_token_index].strip()

