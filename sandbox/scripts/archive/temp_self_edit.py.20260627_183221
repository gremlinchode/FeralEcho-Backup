# import necessary modules: from app.core.self_edit_generated import strip_prose

def strip_prose():
    import re
    with open('self_edit_generated.py', 'r') as file:
        content = file.read()
        pattern = r'^(.*)[\.\?!] '
        new_content = re.sub(pattern, '', content)
        with open('self_edit_generated.py', 'w') as file:
            file.write(new_content)