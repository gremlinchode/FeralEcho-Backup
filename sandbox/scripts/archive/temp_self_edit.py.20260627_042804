import re

def strip_prose(code_output):
    pattern = r"^\s*[\w\W]+?\n"
    cleaned_string = re.sub(pattern, "", code_output)
    if cleaned_string and any(token in cleaned_string for token in ["import", "def", "class"]):
        return code_output
    else:
        return ""

