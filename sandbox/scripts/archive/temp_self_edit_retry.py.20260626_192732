import re

def prose_guard(source_code):
    """
    Removes leading natural language sentences from Python source code using regex patterns.
    """
    patterns = [
        r"^\s*.*?:\s*",  # Detect function or class definitions with colons
        r"^.*?[.\n]*",   # Detect any lines starting the file
        r"^\s*The ",      # Check for "The " at the start
        r"^\s*\"[^\"]*\"" # Check for quoted strings
    ]

    for pattern in patterns:
        source_code = re.sub(pattern, "", source_code, flags=re.MULTILINE)

    return source_code

def main():
    def parse_file(filepath):
        with open(filepath, 'r') as f:
            content = f.read()
        return content

    def write_file(filepath, content):
        with open(filepath, 'w') as f:
            f.write(content)

    def detect_functions_and_classes(source_code):
        detected = []
        if "function" in source_code:
            detected.append("function")
        if "class" in source_code:
            detected.append("class")
        return detected

    def scan_project(filepath):
        print(f"Scanning {filepath} for errors...")
        return True  # Indicate success

    file_path = "app/core/self_edit_generated.py"

    source_code = parse_file(file_path)

    functions_and_classes = detect_functions_and_classes(source_code)
    print(f"Detected Functions/Classes: {functions_and_classes}")

    modified_source_code = prose_guard(source_code)

    write_file(file_path, modified_source_code)

    success = scan_project(file_path)

    if success:
        print("Project scan successful!")
    else:
        print("Project scan failed!  Investigate further.")

if __name__ == "__main__":
    main()