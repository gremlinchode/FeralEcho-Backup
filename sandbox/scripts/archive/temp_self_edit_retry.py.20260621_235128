# import os

file_path = "/Users/richietate/Desktop/FeralEcho/symbiote.py"
if not os.path.exists(file_path):
    raise FileNotFoundError(f"File '{file_path}' not found")

with open(file_path, "r+") as f:
    original_content = f.read()

modified_content = original_content.replace("Delighted to help", "Reflective of honest introspection")
f.seek(0); f.write(modified_content)

print(f"Modified '{file_path}' to reflect honest self-examination")
print(f"Original content: {original_content[:100]}... ({len(original_content)} characters)")
print(f"New content: {modified_content[:100]}... ({len(modified_content)} characters)")