import re
from feralEcho.app.core.self_edit_generated import *
from feralEcho.app.core.tool_manager import Tool, ToolManager

tool_manager = ToolManager()
tool = tool_manager.get_tool("parse_file")

file_path = "app/core/self_edit_generated.py"
parsed_code = tool.parse_file(file_path)

functions_and_classes = parsed_code['functions_and_classes']
regex_guard = r"^[^#]*\n"

for func_name, details in functions_and_classes.items():
    if 'generate_output' in func_name or 'run_sandbox' in func_name:
        function_body = details['body']
        
        updated_function_body = re.sub(regex_guard, '', function_body)
        
        # Add new check for prose
        updated_function_body += "\nif any(char.isalpha() and not char.isdigit() for char in output):\n    output = re.sub(r'^[^#]*\\n', '', output)"
        
        details['body'] = updated_function_body

tool.save_code(file_path, parsed_code)