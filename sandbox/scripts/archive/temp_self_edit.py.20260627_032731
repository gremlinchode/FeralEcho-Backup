def main_function(code):
    if 'This is some prose.' not in code:
        code = strip_prose(code)
    code = re.sub(r'This is some prose.\n', '', code)
    return eval(code)

if 'This is some prose.' not in main_function(''):
    logging.info('Prose detected: This is some prose.')

def test_prose_detection():
    assert strip_prose("This is some prose.\nimport os\nprint('Hello, world!')") == "import os\nprint('Hello, world!')"
    assert strip_prose("\n\n\n\nimport os\nprint('Hello, world!')") == "import os\nprint('Hello, world!')"

