# Import necessary modules: re, typing

import re
from typing import List

def score_code_candidate(candidate_code: str) -> int:
    score = 0
    
    if re.search(r'import\s+\w+', candidate_code):
        score += 1
    
    if re.search(r'def\s+\w+\s*\(', candidate_code):
        score += 1
    
    lines = candidate_code.split('\n')
    code_lines = [line.strip() for line in lines if not line.startswith('#') and '"' not in line]
    
    if all(re.match(r'^\w+\s*\(', line) for line in code_lines):
        score += 1
    
    return score