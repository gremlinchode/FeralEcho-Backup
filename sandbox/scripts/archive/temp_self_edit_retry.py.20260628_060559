import app.core.self_edit_generated
import app.core.tool_manager
from app.core.memory_tools import append_memory_event

class Tool:
    def __init__(self, task):
        self.task = task

    def parse(self, filename):
        with open(filename, 'r') as f:
            content = f.read()
        return content

def strip_prose(line):
    if line.startswith(('def', 'class')):
        parts = line.split(maxsplit=1)
        if len(parts) > 1:
            python_code = parts[1].strip()
            return python_code
    return line

tool = Tool(task='code parsing and string manipulation')
content = tool.parse('app/core/self_edit_generated.py')
lines = content.splitlines()

for i, line in enumerate(lines):
    stripped_line = strip_prose(line)
    if stripped_line != line:
        print(f"Removed prose from line {i+1}: '{line}' -> '{stripped_line}'")
        lines[i] = stripped_line

new_content = '\n'.join(lines)
tool.parse('app/core/self_edit_generated.py')

# Scan the project
from app.core.project_scanner import scanner
scanner.scan('app/core/self_edit_generated.py')

# Log successful prose removal and code edits
append_memory_event("Prose removed and code edits performed successfully.")

