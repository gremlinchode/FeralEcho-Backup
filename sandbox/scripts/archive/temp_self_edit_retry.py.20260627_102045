import os

def modify_main_function():
    from app.core.self_edit_generated import strip_prose, main_function
    from app.core.gemini_shard import parse_file
    
    modified_main_function = lambda x: strip_prose(x) if isinstance(x, str) else x
    
    __main__ = modified_main_function

    def recursive_strip_prose(obj):
        if isinstance(obj, dict):
            return {k: recursive_strip_prose(v) for k, v in obj.items()}
        elif isinstance(obj, list):
            return [recursive_strip_prose(item) for item in obj]
        elif isinstance(obj, str):
            return strip_prose(obj)
        else:
            return obj

    def memory_write_validator(data):
        if isinstance(data, dict):
            for key, value in data.items():
                if not isinstance(key, str) or not isinstance(value, str):
                    return False
        elif isinstance(data, list):
            for item in data:
                if not isinstance(item, str):
                    return False
        elif isinstance(data, str):
            if 'prose' in data.lower():
                return False
        return True

    def recursive_prose_strip():
        for root, _, files in os.walk("app"):
            for file in files:
                if file.endswith(".py"):
                    filepath = os.path.join(root, file)
                    with open(filepath, 'r') as f:
                        content = f.read()
                    new_content = content.replace("main_function = main_function", "main_function = __main__")
                    with open(filepath, 'w') as f:
                        f.write(new_content)

    recursive_prose_strip()
    modify_memory_validator()