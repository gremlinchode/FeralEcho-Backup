# import necessary modules from FeralEcho
import app.core.self_edit_generated
import app.core.tool_manager

def process_self_edit_generated():
    tool = app.core.tool_manager.Tool(task='code parsing and string manipulation')

    try:
        with open('app/core/self_edit_generated.py', 'r') as f:
            content = f.read()

        # Identify lines containing detected prose
        prose_lines = [line for line in content.splitlines() if 'detect_prose' in line]

        for line in prose_lines:
            stripped_line = strip_prose(line, tool)
            if stripped_line:
                print(f"Prose removed from line: {line}")
                app.core.memory_tools.append_memory_event(f"Removed prose: '{line}' and replaced with: '{stripped_line}'")

        # Scan the file for issues
        tool.scan_project('app/core/self_edit_generated.py')
    except Exception as e:
        print(f"An error occurred: {e}")

def strip_prose(line, tool):
    if not line.strip():
        return None

    if line.startswith(('def', 'class')):
        return line
    else:
        start = 0
        while start < len(line) and not line[start].isidentifier() and line[start] != ':':
            start += 1

        if start == len(line):
            return None
        return line[start:]

if __name__ == '__main__':
    process_self_edit_generated()