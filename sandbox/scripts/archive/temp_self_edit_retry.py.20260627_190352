def strip_sandbox_prose(code_output):
    processed_code = ""
    in_python_token = False
    
    for char in code_output:
        if not in_python_token and (char.isalpha() or char.isspace()) and processed_code.startswith('The'):
            lines = code_output.split('\n')
            first_line_tokens = lines[0].split('{')[1].strip().split()
            processed_code = ' '.join(first_line_tokens).strip()
        elif char == '{':
            in_python_token = True
        else:
            processed_code += char
        
    return processed_code

def strip_prose(code_output):
    return strip_sandbox_prose(code_output)