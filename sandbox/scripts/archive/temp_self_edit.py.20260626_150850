import re

def sanitize_output(raw_string):
    regex = re.compile(r'^(.*[\.\?,\!\(\)\[\]]).*')
    sanitized_string = re.sub(regex, r'\1', raw_string)
    return sanitized_string

with open('self_edit_generated.py', 'r') as file:
    python_file = file.read()

generated_code = app.core.self_edit_generated.main_function()
output = sanitize_output(generated_code)

app.core.self_edit_manager.save_code(python_file.replace(generated_code, output))

