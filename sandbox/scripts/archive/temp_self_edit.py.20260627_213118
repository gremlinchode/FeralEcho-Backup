# from feralEcho import strip_prose

def score_candidate_code(candidate_code):
    has_imports = "import" in candidate_code
    has_function_def = "def" in candidate_code
    no_prose_sentences = not strip_prose(candidate_code)
    
    if has_imports and has_function_def and not no_prose_sentences:
        return 3
    elif has_imports and has_function_def and no_prose_sentences:
        return 2
    elif has_imports and not has_function_def and no_prose_sentences:
        return 1
    else:
        return 0