import os
import re

file_path = os.path.join("/Users/richietate/Desktop/FeralEcho/", "feral_echo.py")
original_content = open(file_path, 'r').read()
modified_content = re.sub(r'with open\(file_path, \'r+\'\) as f:', 'with open(file_path, "r") as f:\n', original_content)
with open(file_path, 'w') as f: f.write(modified_content)
print(f"Updated '{file_path}' to remove potential file writing during reading.")
os.system("git add {}".format(file_path))
print(f"'{file_path}' updated and committed")