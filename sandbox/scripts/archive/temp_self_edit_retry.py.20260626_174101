# from app.core.self_edit_generated import *

from detect_functions_and_classes import detect_functions_and_classes
import parse_file
import compress_code

def main_function():
    code = parse_file("app/core/self_edit_generated.py")
    parsed_code = detect_functions_and_classes(code)
    
    for func in parsed_code.functions:
        if func.name == "main_function":
            optimized_func = compress_code(func.body)
            return optimized_func

main_function()