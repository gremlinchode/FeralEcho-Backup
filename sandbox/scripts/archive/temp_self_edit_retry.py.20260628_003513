import importlib
import os
import re

def strip_prose(input_string):
    sentence_pattern = re.compile(r'^[^(\r\n\{\[\(\<\=\+\*\?\|\&\%\^\$\+\+\+\.\,\-\_\/\]\}\)]+')
    
    if sentence_pattern.match(input_string):
        for char in input_string:
            if char in ['(', '[', '{', '<', '=', '+', '*', '?', '|', '&', '%', '^', '$']:
                break
        return input_string[char:]
    return input_string

