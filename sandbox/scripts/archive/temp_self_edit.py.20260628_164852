def strip_leading_natural_language(code: str) -> str:
    pattern = r'^\s*[a-zA-Z0-9][^#].*?\b(?:def|class|if|elif|else|try|except|finally|for|while|with)\b'
    matches = re.match(pattern, code, re.MULTILINE)
    
    if matches:
        return code[matches.end():].lstrip()
    
    return code

def strip_prose(code: str) -> str:
    stripped_code = strip_leading_natural_language(code)
    return stripped_code

def score_code_candidate(candidate: str) -> float:
    cleaned_code = strip_leading_natural_language(candidate)
    original_score = 0.85
    if len(cleaned_code) != len(candidate):
        return original_score * 0.7
    
    return original_score