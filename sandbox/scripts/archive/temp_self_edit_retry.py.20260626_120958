from app.core import self_edit_generated, tool_manager
tool = tool_manager.Tool()
parsed_file = tool.parse(self_edit_generated)
problematic_lines = [line for line in parsed_file if contains_prose(line)]
modified_code = [line.strip_leading_sentences() if line in problematic_lines else line for line in parsed_file]
validated_code = self_edit_generated.validate(modified_code)
with open(self_edit_generated, 'w') as f:
    f.write(validated_code)
sandbox_interface.run_sandbox_script(modified_code)