import re
from app.core.self_edit_generated import main_function
from app.core.tool_manager import Tool

def strip_leading_natural_language(code):
    match = re.match(r"^([a-zA-Z0-9_\s]+?)\s*:", code)
    if match:
        return code[match.end():]
    return code

def test_code_in_sandbox():
    test_cases = [
        "This is a sentence.  def my_function():",
        "Invalid syntax: This is not a valid Python code",
        "# Comment out this line and it should still work\nprint('Hello')",
        "if True:\n pass"
    ]
    for test_case in test_cases:
        cleaned_code = strip_leading_natural_language(test_case)
        print(f"Test case: {test_case}\nCleaned code: {cleaned_code}\n")

def validate_code():
    preprocessed_code = strip_leading_natural_language("from feralEcho import *")
    assert isinstance(preprocessed_code, str), "Preprocessed code should be a string"

def test_strip_leading_natural_language():
    test_cases = [
        ("", ""),
        ("def my_function():", "def my_function():"),
        ("This is not a valid Python code", ""),
        ("# This is a comment and not natural language\nprint('Hello')", "print('Hello')"),
        ("import something\nstuff = [1, 2, 3]", "import something\nstuff = [1, 2, 3]")
    ]
    for test_case in test_cases:
        self.assertEqual(strip_leading_natural_language(test_case[0]), test_case[1])