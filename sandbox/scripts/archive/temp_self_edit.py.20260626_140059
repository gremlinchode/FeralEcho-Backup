# Import necessary modules
from feralEcho.app.core.self_edit_generated import *
from feralEcho.app.core.tool_manager import *

import re

def modify_sandbox_execution():
    files = list_python_files()
    file_obj = parse_file('self_edit_generated.py')
    
    sandbox_code = file_obj['sandbox_execution']
    
    def strip_leading_natural_language(output):
        match = re.match(r"^\s*([A-Za-z0-9\s]+)?", output)
        if match:
            return match.group(1) or ""
        else:
            return output

    modified_sandbox_code = sandbox_code.replace("print(*output)", "filtered_output = strip_leading_natural_language(output); print(filtered_output)")
    
    file_obj['sandbox_execution'] = modified_sandbox_code
    
    try:
        compile(modified_sandbox_code, 'self_edit_generated.py', 'exec')
        exec(modified_sandbox_code)
    except Exception as e:
        print(f"Error: {e}")

    parse_file('self_edit_generated.py')