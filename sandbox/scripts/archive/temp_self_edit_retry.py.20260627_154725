# import necessary modules and functions
import re
from app.core.self_edit_generated import strip_prose

def strip_leading_prose(code_output):
    pattern = r'^[^#].*'
    match = re.search(pattern, code_output)
    
    if match:
        leading_text = code_output[:match.start()]
        return leading_text.strip()
    else:
        return ""

def strip_prose(code_output):
    return strip_leading_prose(code_output)