from app.core.self_edit_generated import strip_prose_to_python_token

import re

def strip_prose_to_python_token(code):
    prose = re.match(r'^\s*\w+(?=[\(\)\[\]\{\},\.\:\;\?\!\*\/\+\-])', code)
    if prose:
        sentences = [sentence.strip() for sentence in prose.group().split('.')]
        for sentence in sentences:
            if any(char.isalnum() or char.isspace() or char in ['.', ';'] for char in sentence):
                return code[code.index(sentence) + len(sentence):]
    return code