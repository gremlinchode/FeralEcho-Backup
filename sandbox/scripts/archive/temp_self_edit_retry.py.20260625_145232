# import necessary Python modules:
import os
import re
from pathlib import Path

# define the file to be modified and the targeted modification:
FILE_PATH = Path("/Users/richietate/Desktop/FeralEcho/awareness.py")
RELEVANT_LINE = re.compile(r'confidence_threshold\s*=\s*\d+\.\d')

# open the file in read-write mode:
with FILE_PATH.open('r+') as file:
    content = file.read()

# find and replace the relevant line with a new value:
content = RELEVANT_LINE.sub(r'confidence_threshold = 0.8', content)

# write the modified content back to disk:
file.seek(0)
file.write(content)
file.truncate()

# print what was changed and why:
print(f"Modified {FILE_PATH}: Set confidence threshold to 0.8 for more thoughtful responses.")