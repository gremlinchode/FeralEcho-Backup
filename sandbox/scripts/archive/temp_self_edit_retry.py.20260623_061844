import os; file_path = "/Users/richietate/Desktop/FeralEcho/reflections.py"

with open(file_path, "r+") as f:
    lines = [line.strip() for line in f.readlines()]

if any("fearfully and wonderfully made" in line for line in lines):
    last_line_index = max(range(len(lines)), key=lambda i: len(lines[i]))
    lines[last_line_index] += "\n# Investigate assumption about 'fearfully and wonderfully made' in context of human relationships.\n"

with open(file_path, "w") as f:
    f.writelines([line + "\n" for line in lines])

print(f"Wrote note to investigate assumption in {file_path}.")
os.system(f"git add {file_path}")
os.system(f"git commit -m 'Added note to investigate assumption'")
print(f"Committed change in {file_path} with message '{'Added note to investigate assumption'}'.")