import sys

def modify_stopping_condition(file_path):
    with open(file_path, 'r+', encoding='utf-8') as file:
        content = file.read()
        modified_content = content.replace("def find_and_modify_stopping_condition(", "def find_and_modify_stopping_condition(self, ")
        file.seek(0)
        file.write(modified_content)
        file.truncate()
    print("Modified find_and_modify_stopping_condition.py to add self parameter.")
    
    original_file_hash = hash(open(file_path, 'rb').read())
    modified_file_hash = hash(open(file_path, 'rb').read())
    print(f"Original file hash: {original_file_hash}, Modified file hash: {modified_file_hash}")