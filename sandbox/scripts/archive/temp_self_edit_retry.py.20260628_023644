# import necessary modules
import re

from app.core.self_edit_generated import strip_prose

def strip_prose(code_output):
    """Strip natural language sentences from code output."""
    if re.search(r"^[a-zA-Z\s]+:?", code_output) is not None:
        matched_text = re.search(r"^[a-zA-Z\s]+:?", code_output).group()
        code_output = code_output[matched_text.length():]
    return code_output

