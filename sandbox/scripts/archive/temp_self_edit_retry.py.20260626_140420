from app.core.self_edit_generated import *
from app.core.tool_manager import *

def prose_guard(code):
    while code and not code.lstrip().startswith('import') or code.lstrip().startswith('def'):
        code = '\n'.join(code.split('\n')[1:])
    return code

parse_file()

functions_and_classes = detect_functions_and_classes('app/core/self_edit_generated.py')
for func_name, func_code in functions_and_classes.items():
    if 'sandbox_execution' in func_name.lower() or 'output_generation' in func_name.lower():
        new_func_code = func_code.replace('return code', 'return prose_guard(code)')
        setattr(app.core.self_edit_generated, func_name, eval(new_func_code))

validate_sandbox_execution()

save_code('app/core/self_edit_generated.py')

plan_code_logic()