import ollama_handler
from ToolManager import register_tool, update_config, record_tool_registration, update_awareness

if ollama_handler.is_ollama_running():
    code = ollama_handler.query_ollama(prompt="Generate Python code for integrating 'ollama_query' as a tool in Echo.")
    generated_code = ollama_handler.generate_code(code)
    parse_function = detect_functions_and_classes(generated_code)
    
    if "ollama_query" in parse_function:
        register_tool('ollama_query', generated_code, "Generated code for integrating 'ollama_query' into the Echo system's tools.")
        update_config('ollama_query', {'enabled': True})
        record_tool_registration()
        update_awareness()
    else:
        print("Ollama server returned invalid or unknown response.")