import app.core.self_edit_generated
import app.core.tool_manager
from re import search, sub

def prose_guard(code):
    pattern = r'^[A-Za-z\s]*\n'
    while True:
        match = search(pattern, code)
        if not match:
            break
        code = sub(pattern, '', code)
    return code if code else ''

if __name__ == '__main__':
    try:
        sanitized_code = prose_guard("This is a sample Python function.  def my_function():")
        print(f"Original Code:\n{sanitized_code}")
        
        app.core.self_edit_generated.execute_command("prose_guard", sanitized_code) 

        import logging
        logging.info("Prose guard successfully applied")

    except Exception as e:
        print(f"An error occurred: {e}")