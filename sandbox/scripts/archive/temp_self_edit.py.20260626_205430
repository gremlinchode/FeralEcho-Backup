import re

def new_main_function():
    def detect_and_strip_prose(input_string):
        prose_guard_pattern = r'^(\s*\w+)?(.*?)(?:\r\n\t)+'
        match = re.match(prose_guard_pattern, input_string)
        if match:
            return input_string[match.end():].strip()
        else:
            return input_string

    def main_function(input_string):
        return detect_and_strip_prose(input_string)

    app.core.self_edit_generated.main_function = new_main_function