def score_reasoning_candidate(code_string):
    has_imports = any(line.strip().startswith("import") for line in code_string.splitlines())
    has_function_def = detect_functions_and_classes(code_string)
    
    no_prose_sentences = [line.strip() for line in code_string.splitlines() if not line.strip().endswith(('.', '?', '!'))]
    
    score = 0
    if not has_imports:
        score += 1
    if has_function_def:
        score += 1
    if len(no_prose_sentences) == 0:
        score += 1
    
    return score