def strip_prose(code_output):
    import re
    try:
        if re.search(r"[\.,;\?!\s]+", code_output, re.IGNORECASE):
            matched_text = re.search(r"[\.,;\?!\s]+\s*", code_output, re.IGNORECASE).group()
            code_output = code_output[matched_text.length():]
    except AttributeError:
        pass
    """Detect and strip natural language sentences from the beginning of code output."""
    return code_output

