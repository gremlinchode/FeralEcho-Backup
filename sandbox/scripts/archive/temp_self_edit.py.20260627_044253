from app.core.self_edit_generated import strip_prose, main_function, modified_main_function
from app.core.memory_bridge import append_to_journal
from app.emergent_scheduler_backup_20260610 import score_response_quality
from app.autonomous_loop import run_cartographer

original_code = parse_file('app/core/self_edit_generated.py', 'main_function')
refactored_code = strip_prose(original_code, target_length_reduction=0.2)
test_result = run_cartographer(modified_main_function)
if test_result['error']:
    print(f"Error detected: {test_result['error']}")

response_length_score = score_response_quality(refactored_code)
if response_length_score < 0.8:
    modified_main_function.__code__ = original_code
    print("Reverting to original code")
else:
    append_to_journal(f"Modified code passed with a response length score of {response_length_score}")

append_to_journal(f"Modified main function: {refactored_code.decode('utf-8')}")

analysis_result = analyze_python_code(refactored_code)
if analysis_result['error']:
    print(f"Error detected during analysis: {analysis_result['error']}")