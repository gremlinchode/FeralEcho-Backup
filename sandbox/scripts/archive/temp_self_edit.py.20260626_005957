# import necessary modules
import os; import numpy as np; from memory_bridge import rebuild_vector_memory

# define function to integrate awareness scores
def integrate_awareness_scores(awareness_scores: np.ndarray) -> np.ndarray:
    vector_memory = np.load('vector_memory.npy')
    rebuilt_vector_memory = rebuild_vector_memory(vector_memory)
    new_awareness_scores = np.concatenate((awareness_scores, rebuilt_vector_memory))
    diff = np.abs(new_awareness_scores - awareness_scores)
    threshold = 0.5
    if np.any(diff > threshold):
        log_memory_event(diff, threshold)

    return new_awareness_scores