def refactor_main_function(code):
    def strip_leading_prose(new_code):
        code = new_code.split(maxsplit=0)[1].lstrip() if not new_code.lstrip().startswith('(') else new_code.lstrip().split('(')[0]
        return code
    
    code = strip_leading_prose(code)
    
    return code

