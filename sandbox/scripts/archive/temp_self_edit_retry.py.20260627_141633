def shorten_response_length(response_length, strip_prose):
    if strip_prose:
        response_length = int(len(regex_helper.strip_prose(response_length)))
    return response_length

def strip_prose(text):
    import re
    text = re.sub(r'^\s*(?:[A-Z][a-z]+\s+)?', '', text, flags=re.MULTILINE)
    if len(re.split(r'(?<=[A-Z].*?)(^[\w\W]+.*?(?:\\n){1})', text, flags=re.MULTILINE)) > 1:
        return ' '.join(re.split(r'(?<=[A-Z].*?)(^[\w\W]+.*?(?:\\n){1})', text, flags=re.MULTILINE)[1:])
    else:
        return text