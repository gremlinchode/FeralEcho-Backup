import re
from app.core.self_edit_generated import shorten_response_length

def sandbox_prose_guard(code_output):
    if code_output.startswith((" ", "\t", "#")):
        for line in code_output.split("\n"):
            if line.lstrip().startswith(("*" , "—" , "(" , "[")):
                return ""
            elif "#" in line and ":" in line and "*" not in line and "--" not in line and ")" not in line and "]" not in line:
                continue
            else:
                return code_output.split("\n")[0] + "\n"
    pattern = re.compile(r'^\s*[^\n]*[^\s].*$')
    code_output = pattern.sub('', code_output).strip()
    if code_output:
        return code_output
    return ""

shortened_code = shorten_response_length()
shortened_code = sandbox_prose_guard(shortened_code)