# Import necessary modules from feralEcho importable modules:
import app.emergent_scheduler_backup_20260610 as emergent_scheduler_backup_20260610
import app.core.self_edit_generated as self_edit_generated

# Load the current project map using load_project_map() from app.core.load_project_map:
load_project_map = emergent_scheduler_backup_20260610.load_project_map

# Strip prose from the loaded project map using strip_prose() from app.core.self_edit_generated:
strip_prose = self_edit_generated.strip_prose

def refactor_code_generation(project_map):
    def recursive_refactor(prose_str, original_str=""):
        if not prose_str:
            return strip_prose(original_str)
        else:
            first_break = prose_str.find(" ")
            rest_str = prose_str[first_break:]
            original_str += " " + rest_str
            new_str = strip_prose(rest_str)
            append_memory_entry(new_str, "Refactored Code Generation")
            log_memory_edit(original_str)
            return recursive_refactor(prose_str[:first_break], original_str)

    def recursive_code_generation(project_map):
        if not project_map:
            return ""
        else:
            first_entry = project_map.pop(0)
            new_str = recursive_refactor(first_entry, "")
            append_memory_entry(new_str, "Recursively Generated Code")
            log_memory_edit(new_str)
            return recursive_code_generation(project_map) + new_str

    return recursive_code_generation(project_map)

def main():
    project_map = load_project_map()
    refactored_code = refactor_code_generation(project_map)
    run_cartographer(emergent_scheduler_backup_20260610, refactored_code)

if __name__ == "__main__":
    main()