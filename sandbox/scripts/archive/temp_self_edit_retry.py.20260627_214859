import re
from app.core.self_edit_generated import detect_functions_and_classes

def strip_leading_prose(prose_string):
    leading_sentence_pattern = r'^.*?([A-Za-z\s]+)$'
    matching_group = re.search(leading_sentence_pattern, prose_string)
    
    if matching_group:
        leading_sentence = matching_group.group(1).strip()
        return f'"{leading_sentence}"\n{prose_string[len(leading_sentence)+1:]}'
    else:
        return prose_string

def strip_prose(input_string):
    return strip_leading_prose(input_string)

