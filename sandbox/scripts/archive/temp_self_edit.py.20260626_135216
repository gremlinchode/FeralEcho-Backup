import re
from feralEcho.app.core.self_edit_generated import *
from feralEcho.app.core.tool_manager import *

def score_code_string(code_string):
    quality_score = 0
    
    has_imports = bool(re.search(r"import\s*\w+", code_string))
    if has_imports:
        quality_score += 1

    has_function_def = bool(re.search(r"def\s+\w+.*:", code_string))
    if has_function_def:
        quality_score += 2

    sentences = re.split(r"[.?!]", code_string)
    for sentence in sentences:
        sentence = sentence.strip()
        if sentence and any(char.isalpha() for char in sentence):
            no_prose_sentences = True
            break
    else:
        no_prose_sentences = False
    
    if has_imports and has_function_def and no_prose_sentences:
        quality_score += 3
    
    return quality_score