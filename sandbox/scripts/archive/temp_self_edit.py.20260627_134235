# import necessary modules
from app.core.self_edit_generated import *
from app.core.memory_bridge import *

def strip_prose(self, input_str):
    import re
    leading_sentences = re.search(r"^(What can I|I am a|As a|Why is the).*", input_str)
    if leading_sentences:
        return ""
    else:
        return input_str

def shorten_response_length(self, input_str):
    if isinstance(input_str, str):
        return strip_prose(self, input_str)
    elif hasattr(input_str, "__len__"):
        return len(input_str)
    else:
        return None