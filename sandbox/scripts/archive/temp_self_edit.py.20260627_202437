code = strip_prose('Original code')
modified_code_lines = []
for line in code.split('\n'):
    modified_line = line.strip()[::0.8]  # trim 20%
    modified_code_lines.append(modified_line)
refactored_code = '\n'.join(modified_code_lines)
final_code = strip_prose(refactored_code)

with open('app/core/self_edit_generated.py', 'w') as f:
    f.write(final_code)