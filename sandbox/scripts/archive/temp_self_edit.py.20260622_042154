file_path = "memory_journal.py"
with open(file_path, 'r') as f: lines = [line.strip() for line in f.readlines()]
new_lines = ["import logging\nlogging.basicConfig(filename='memory_log.txt', level=logging.INFO)" if i == 0 else line for i, line in enumerate(lines)]
with open(file_path, 'w') as f: f.writelines([line + '\n' for line in new_lines])
print(f"Updated {file_path} to include logging setup at the top.")
import os; os.remove('memory_log.txt')
print(f"Removed existing memory log file.")