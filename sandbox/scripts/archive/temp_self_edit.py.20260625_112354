# import required modules

import parse_file
from detect_functions_and_classes import detect_functions_and_classes
from generate_parameter_hints import generate_parameter_hints
from calculate_awareness_score import calculate_awareness_score
from calculate_consciousness_score import calculate_consciousness_score
from append_memory_entry import append_memory_entry

parsed_contents = parse_file.parse('echo_model_orchestrator.py')

query_function = detect_functions_and_classes(parsed_contents, 'ollama_query')

param_hints = generate_parameter_hints()

if param_hints:
    if any(param in str(query_function) for param in param_hints):
        query_function = calculate_awareness_score(query_function)
        query_function = calculate_consciousness_score(query_function)

append_memory_entry(parsed_contents, query_function, param_hints)