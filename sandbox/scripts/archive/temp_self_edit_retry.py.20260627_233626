import os
import re

def enhanced_strip_prose(text):
    if detect_leading_prose(text):
        return text.splitlines()[0].strip()
    else:
        match = re.match(r'^[a-zA-Z][^.!?]*[.!?]\s*', text)
        if match:
            return text[len(match.group()):].lstrip()
        return text.strip()

def update_imports(file_path):
    with open(file_path, 'r') as file:
        lines = file.readlines()

    new_lines = [re.sub(r'from app\.core\.self_edit_generated import strip_prose', 'from app.core.self_edit_generated import enhanced_strip_prose', line) for line in lines]

    with open(file_path, 'w') as file:
        file.writelines(new_lines)

# Load original file
with open(os.path.join('app', 'core', 'self_edit_generated.py'), 'r') as f:
    content = f.read()

# Replace original strip_prose() method
content = content.replace('def strip_prose(text):', 'def enhanced_strip_prose(text):\n' + str(enhanced_strip_prose.__code__))

# Save modified file
with open(os.path.join('app', 'core', 'self_edit_generated.py'), 'w') as f:
    f.write(content)

for root, _, files in os.walk('app/core'):
    for file in files:
        if file.endswith('.py') and 'self_edit_generated.py' not in file:
            update_imports(os.path.join(root, file))