# import app.core.self_edit_generated

from typing import List, Tuple

def strip_prose(self_edit_generated: self_edit_generated) -> None:
    def detect_prose(input_str: str) -> bool:
        return input_str.startswith(("Who", "When", "Where", "What"))
    for line in self_edit_generated.strip_prose():
        if not detect_prose(line):
            yield from line
        else:
            break