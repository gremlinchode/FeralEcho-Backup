# import necessary modules and load existing self-edit generated module
import importlib
import strip_prose
from app.core.self_edit_generated import SelfEditGenerated

# define the strip_sandbox_script function to remove leading natural-language sentences
def strip_sandbox_script(script):
    return strip_prose.strip_script(script)

# update the run_random_sandbox_script function to use the new strip_sandbox_script function
SelfEditGenerated.run_random_sandbox_script = lambda self: strip_sandbox_script(self.run_random_sandbox_script())

# check for prose and strip it if present before running the script
if __name__ == "__main__":
    try:
        script = SelfEditGenerated().run_random_sandbox_script()
        if strip_prose.has_prose(script):
            script = strip_sandbox_script(script)
    except Exception as e:
        print(f"Error: {e}")