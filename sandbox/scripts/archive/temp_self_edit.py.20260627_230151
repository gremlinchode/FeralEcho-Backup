# Import necessary modules and tools
import importlib.util
import app.core.self_edit_generated as self_edit_generated
from app.core.project_scanner import detect_functions_and_classes

# Define target response length reduction percentage
target_response_length_reduction_percentage = 20.

# Calculate average response length of the original strip_prose function
average_response_length = sum(detect_functions_and_classes(self_edit_generated).responses()) / len(detect_functions_and_classes(self_edit_generated).responses())

# Determine desired target response length by reducing average response length
desired_target_response_length = average_response_length * (1 - target_response_length_reduction_percentage/100)

# Define strip_prose function with target response length parameter
def strip_prose(text, target_response_length=desired_target_response_length):
    while True:
        truncated_text = text[:target_response_length].rjust(len(text))
        if len(truncated_text) == len(text):
            break
        target_response_length -= 1
    return truncated_text

# Loop through generated code and truncate it to the desired length
for code in self_edit_generated.responses():
    code = strip_prose(code, target_response_length=desired_target_response_length)
    print(code)

print(target_response_length)