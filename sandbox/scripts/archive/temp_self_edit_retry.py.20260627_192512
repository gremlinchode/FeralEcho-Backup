import re
from app.core.self_edit_generated import strip_prose
def strip_prose_modified(code):
    code = re.sub(r'^\s*\w+(?=.*python)', '', code, flags=re.MULTILINE)
    return code
def strip_prose(code):
    return strip_prose_modified(code)
try:
    with open('app/core/self_edit_generated.py', 'r') as f:
        content = f.readlines()
    
    new_content = []
    for line in content:
        new_content.append(strip_prose(line.strip()))
    
    with open('app/core/self_edit_generated.py', 'w') as f:
        f.writelines(new_content)
except FileNotFoundError:
    print("File not found.")