import app.core.memory_helpers
import re

def strip_prose(code):
    sentences = re.split(r'(?m)(^.*\.\s*)', code)
    return [sentence for sentence in sentences if not re.search(r'\b(?:who|what|where|when|why)\b', sentence, re.IGNORECASE)]

class ProseDetectionGuard:
    def __init__(self):
        pass

    def execute(self, code):
        stripped_code = strip_prose(code)
        if stripped_code != code:
            log_memory_event("Prose detection guard triggered")
        return self.execute(stripped_code)

