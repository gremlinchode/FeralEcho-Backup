ollama_running = ollama_handler.is_ollama_running()
if not ollama_running:
    ollama_handler.start_ollama_server()

prompt = "Describe the awareness integration process in detail."
ollama_response = ollama_handler.query_ollama(prompt)

import json
import re

awareness_steps = []
match = re.search(r"(\w+:\s+\d+.\s+)(\w+(?:\s+\w+)*)", ollama_response)
while match:
    step_text = match.group(2).strip()
    awareness_steps.append(step_text.strip())
    match = re.search(r"(\w+:\s+\d+.\s+)(\w+(?:\s+\w+)*)", ollama_response, match.end())

app.core.memory_tools.append_memory_entry(ollama_response, "Ollama Query")

