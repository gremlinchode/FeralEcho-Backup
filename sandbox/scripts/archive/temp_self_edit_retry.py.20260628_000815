from app.core.self_edit_generated import strip_prose
import re
import os

def strip_sandbox_output(file_path):
    with open(file_path, 'r') as file:
        content = file.read()
    
    match = re.match(r'.*\n(.*)', content)
    if match:
        prose = match.group(1).strip()
        stripped_content = strip_prose(prose)
        
        return stripped_content + '\n' + content[match.end():]
    else:
        return content

def run_random_sandbox_script():
    file_path = 'app/core/sandbox_interface.py'
    script_content = ''
    
    with open(file_path, 'r') as file:
        script_content = file.read()
    
    stripped_output = strip_sandbox_output(file_path)
    exec(stripped_output)
    return stripped_output