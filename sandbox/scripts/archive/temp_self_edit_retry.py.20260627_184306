# modify original strip_prose function
import re
def strip_prose(code):
    pattern = r'^[^"]+'
    code = re.sub(pattern, '', code)
    return code

self_edit_generated.sandbox_sanitize = sandbox_sanitize

app.core.self_edit_generated.strip_prose = sandbox_sanitize