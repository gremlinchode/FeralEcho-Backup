def shorten_code_candidates(candidates):
    shortened_candidates = []
    for candidate in candidates:
        cleaned_code = strip_leading_natural_language(candidate)
        original_score = 0.85
        if len(cleaned_code) != len(candidate):
            return original_score * 0.7
        
        return original_score
    
    refactored_candidates = []
    refactored_average_length = None
    while True:
        new_refactored_candidates = []
        for candidate in refactored_candidates:
            shortened_candidate = shorten_code_candidates([candidate])
            new_refactored_candidates.append(shortened_candidate)
        
        if abs((sum(map(len, [strip_prose(c) for c in new_refactored_candidates])) / len(new_refactored_candidates)) - (refactored_average_length or sum(map(len, [strip_prose(c) for c in refactored_candidates])) / len(refactored_candidates))) / ((refactored_average_length or sum(map(len, [strip_prose(c) for c in refactored_candidates])) / len(refactored_candidates)) or 1) * 100 <= 20:
            break
        
        refactored_candidates = new_refactored_candidates
        refactored_average_length = sum(map(len, [strip_prose(c) for c in refactored_candidates])) / len(refactored_candidates)
    
    return refactored_candidates