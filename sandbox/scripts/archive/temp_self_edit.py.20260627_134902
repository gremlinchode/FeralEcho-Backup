import self_edit_generated
import re

def strip_leading_sentences(text):
    pattern = r'^.*?(\([^()]+|\s+)"[^"]*".*?\n)'
    text = re.sub(pattern, '', text)
    return text

def shorten_response_length():
    response = get_verse_range()
    response = strip_leading_sentences(response)
    return len(response)

self_edit_generated.shorten_response_length = shorten_response_length

def run_random_sandbox_script():
    app.core.sandbox_interface.run_random_sandbox_script()

run_random_sandbox_script()