# import necessary modules
from app.core.self_edit_generated import shorten_response_length

def strip_prose(text):
    while True:
        try:
            sentence_start = text.index('\n') if '\n' in text else -1
            if sentence_start > 0:
                text = text[:sentence_start].strip()
                break
        except ValueError:
            pass
        if not any(char.isalpha() or char.isdigit() for char in text[0]):
            return text

def updated_shorten_response_length(text, max_length):
    strip_prose(text)
    return text[:max_length]

shorten_response_length.__code__ = updated_shorten_response_length.__code__.replace('return text', 'return strip_prose(text)')

prose_detection_active = True