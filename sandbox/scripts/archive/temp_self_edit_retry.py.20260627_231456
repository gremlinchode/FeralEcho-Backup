import strip_prose

def update_strip_prose():
    def modify_file(content):
        start = 0
        while True:
            start = content.find('\n', start)
            if start == -1:
                break
            end = content.find('\n', start + 1)
            if end == -1:
                break
            
            line = content[start:end].strip()
            if line and not line[0].isalnum():
                continue
            return line
    
    with open('app/core/self_edit_generated.py', 'r') as file:
        content = file.read()
    
    while True:
        line = modify_file(content)
        if line is None:
            break
        content = content.replace(line, '')
    
    with open('app/core/self_edit_generated.py', 'w') as file:
        file.write(content)

update_strip_prose()