# import required modules
import app.core.self_edit_generated
import app.core.tool_manager

def score_candidate_code(code):
    has_imports = 0
    has_function_def = 0
    no_prose_sentences = 0
    
    # count imported modules and increment has_imports if any
    files = tool_manager.list_python_files()
    for file in files:
        with open(file, 'r') as f:
            content = f.read()
            if any(line.strip().startswith('import ') for line in content.splitlines()):
                has_imports += 1
    
    # detect function definitions and increment has_function_def if any
    functions_and_classes = self_edit_gen.detect_functions_and_classes(code)
    if functions_and_classes['functions']:
        has_function_def += len(functions_and_classes['functions'])
    
    # count prose sentences using regex or similar text analysis
    import re
    sentence_count = len(re.split(r'(?<=[.!?])\s+', code))
    
    # increment no_prose_sentences if no prose sentences are detected
    if sentence_count == 0:
        no_prose_sentences += 1
    
    # calculate overall quality score, capped at 3 based on number of imports
    quality_score = min(has_imports + has_function_def + no_prose_sentences, 3)
    
    return quality_score