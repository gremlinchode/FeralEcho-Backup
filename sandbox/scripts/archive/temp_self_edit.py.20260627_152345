from app.core.tool_manager import ToolManager

def tighter_prose_detection(code):
    tokens = code.split()
    if len(tokens) > 0 and tokens[0].isalpha():
        for i, token in enumerate(tokens):
            if token.isidentifier() or token == 'def' or token == 'class':
                return ' '.join(tokens[i:])
    return code

def strip_prose(code):
    return tighter_prose_detection(code)