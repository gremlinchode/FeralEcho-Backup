from app.core.tool_manager import *

def score_candidate_code(candidate_code):
    has_imports = 0
    has_function_def = 0
    no_prose_sentences = 0

    if "import" in candidate_code:
        has_imports += 1
    if "def" in candidate_code and any(char.isalpha() for char in candidate_code):
        has_function_def += 1
    if "." not in candidate_code:
        no_prose_sentences = 1
    else:
        sentences = candidate_code.split('.')
        for sentence in sentences:
            if not sentence.strip():
                continue
            if not (sentence[-1] in ['.', '!', '?'] or any(char.isalpha() for char in sentence)):
                no_prose_sentences += 1

    return has_imports + has_function_def + no_prose_sentences