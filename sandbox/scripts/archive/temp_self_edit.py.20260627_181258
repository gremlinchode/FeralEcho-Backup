from app.core.self_edit_generated import strip_prose_to_python_token

def strip_prose_to_python_token():
    output_text = ''
    while True:
        line = input()
        if re.match(r'^\s*(?:\([^)]*\)|[a-zA-Z_][a-zA-Z0-9_]*\):?', line):
            output_text += line + '\n'
            break
        else:
            continue
    return output_text