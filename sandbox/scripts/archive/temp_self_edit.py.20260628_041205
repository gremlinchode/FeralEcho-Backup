    lines = code_output.split('\n')
    for line in lines:
        stripped_line = line.strip()
        if not stripped_line or is_python_token(stripped_line[0]):
            return '\n'.join(lines).lstrip()
        else:
            line = stripped_line.lstrip()
    return code_output

