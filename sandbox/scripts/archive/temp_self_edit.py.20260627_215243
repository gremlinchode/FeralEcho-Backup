from app.core.self_edit_generated import strip_prose
import re

strip_prose = lambda text: re.sub(r'^(.*[\s\.,:!?]*)(#|def|class)\s*', r'\2', text, flags=re.MULTILINE)

def modify_strip_prose():
    try:
        test_code = "print('Hello, world!') This is some prose that should be removed."
        stripped_code = strip_prose(test_code)
        print("Original Code:", test_code)
        print("Stripped Code:", stripped_code)

    except Exception as e:
        print(f"Error during modification: {e}")

def run_tests():
    test_cases = [
        "print('Hello, world!') This is some prose that should be removed.",
        "def my_function():\n  return 'This is a comment' + 'And another sentence'",
        "if True:\n    print(\"True\")\nelse: print(\"False\")",
        "import os\nprint('os.path.exists')"
    ]

    for test_case in test_cases:
        stripped = strip_prose(test_case)
        print(f"\nOriginal: {test_case}")
        print(f"Stripped: {stripped}")

if __name__ == "__main__":
    modify_strip_prose()
    run_tests()