def modify_file(file_path):
    with open(file_path, 'r') as file:
        lines = file.readlines()
    for i, line in enumerate(lines):
        if line.strip().startswith('#'):
            lines[i] = line.replace('import os', '')
    with open(file_path, 'w') as file:
        file.writelines(lines)
    print(f"Removed unnecessary import statement from {file_path}")
    with open(file_path, 'r') as f:
        current_content = f.read()
    fixed_content = current_content.replace('if os.path.isfil', 'if os.path.isfile')
    f.seek(0); f.write(fixed_content); f.close(); print(f"Modified '{file_path}' - Completed if-statement")