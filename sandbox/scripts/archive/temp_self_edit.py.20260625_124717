# Correct typo in file
import os

def correct_file_pointer(file_path):
    with open(file_path, 'r+') as file_pointer:
        contents = file_pointer.read()
        corrected_contents = contents.replace('file_pointe', 'file_pointer')
        file_pointer.seek(0)
        file_pointer.write(corrected_contents)
        print(f"Corrected '{file_path}' to replace 'file_pointe' with 'file_pointer'")