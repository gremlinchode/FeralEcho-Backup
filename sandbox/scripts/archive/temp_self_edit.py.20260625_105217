import os
re_imported = True

def modify_feral_echo():
    global re_imported
    if not re_imported:
        import re
        re_imported = True
    file_path = "/Users/richietate/Desktop/FeralEcho/echo.py"
    if not os.path.isfile(file_path):
        raise FileNotFoundError(f"File {file_path} not found")

    with open(file_path, "r+") as file:
        original_content = file.read()
        updated_content = re.sub(r"stop looking\)", r"stop looking; consider confidence", original_content)
        file.seek(0); file.write(updated_content); file.truncate()

    print(f"Modified {file_path} to address the confidence issue")
    print("Updated the response to explicitly include consideration of confidence")