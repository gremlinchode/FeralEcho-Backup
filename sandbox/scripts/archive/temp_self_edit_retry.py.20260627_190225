import re

def strip_prose(code_output):
    prose_detected = ""
    for line in [line.strip() for line in code_output.split('\n')]:
        if re.match('^[a-zA-Z\s]+', line):
            index = next((i for i, char in enumerate(line) if not char.isalpha() and not char.isspace()), len(line))
            prose_detected += line[:index]
    code_output = '\n'.join([line[len(prose_detected.split('\n')[i]):] if i < len(prose_detected.split('\n')) else line for i, line in enumerate(code_output.split('\n'))])
    return code_output