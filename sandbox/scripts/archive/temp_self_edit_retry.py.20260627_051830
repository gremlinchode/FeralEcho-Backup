import re

def strip_prose(line):
    import re
    tokens = re.split(r'(?<=[.!?]) +', line)
    for token in tokens:
        if not token.strip().startswith(('import', 'def', 'class')):
            return token.strip()
        else:
            break
    return ''

tool_manager.scan_project('app/core/self_edit_generated.py')

with open('app/core/self_edit_generated.py', 'r') as file:
    code = file.read()

updated_code = ''
lines = code.split('\n')
for line in lines:
    if strip_prose(line):
        updated_code += line + '\n'
    else:
        updated_code += line

with open('app/core/self_edit_generated.py', 'w') as file:
    file.write(updated_code)

