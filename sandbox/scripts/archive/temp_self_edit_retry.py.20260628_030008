import app.core.self_edit_generated
from FeralEcho.app.gemini_shard import GeminiShard
import app.core.tool_manager

def detect_and_strip_prose(code):
    gemini_shard = GeminiShard()
    sentences = gemini_shard.detect_sentences(code)
    if sentences:
        return code.split(sentences[0], 1)[1].lstrip()
    else:
        return code

app.core.self_edit_generated.strip_prose = detect_and_strip_prose

prose_detected = False

def parse_code(code):
    global prose_detected
    if prose_detected:
        return detect_and_strip_prose(code)
    # Add your parsing logic here
    return code

app.core.self_edit_generated.parse_code = parse_code

prose_detected = True

update_file('app/core/self_edit_generated.py', 'stripped_code = strip_prose(remaining_code)')

from FeralEcho.app.core.autonomous_awareness import run_self_model_reflection
run_self_model_reflection()