# import necessary modules from app.core.self_edit_generated
from app.core.self_edit_generated import shorten_response_length

def new_shorten_response_length(response):
    if re.match(r'^\s*[A-Za-z .]+(?=\w+)', response):
        prose_start = 0
        for char in range(len(response)):
            if not re.match(r'\W', response[char]):
                prose_start = char
                break
        return response[prose_start:]
    else:
        return response

assert new_shorten_response_length('this is a test').strip() == 'this is a test'