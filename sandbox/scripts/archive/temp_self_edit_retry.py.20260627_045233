import logging
import re

logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)-8s - %(message)s', datefmt='%Y-%m-%d %H:%M:%S')
logger = logging.getLogger(__name__)

def prose_guard(code_string):
    pattern = r".*?([#;]\s*\w+)|(\w+)"
    match = re.search(pattern, code_string)
    if match:
        return code_string[:match.start()]
    else:
        return code_string

def main_function():
    code_string = input("Enter the code string: ")
    code_string = prose_guard(code_string)
    print(f"Processed code: {code_string}")

