import re

def prose_guard(code):
    pattern = r'^\s*([A-Za-z ]+)$'
    if re.match(pattern, code):
        code = re.sub(pattern, '', code)
        for phrase in [r'from\s+', r'def\s+', r'class\s+']:
            if re.match(phrase, code):
                code = re.sub(r'^.*?(' + re.escape(phrase) + ')', '', code, flags=re.M)
                break
    return code or ''

