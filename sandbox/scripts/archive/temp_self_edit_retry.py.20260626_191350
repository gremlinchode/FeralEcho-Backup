import re
from feralEcho.app.core import self_edit_generated, tool_manager

def prose_guard(input_string):
    pattern = re.compile(r'^[^`]+: ')
    if pattern.match(input_string):
        return input_string.split(':')[1].strip()
    else:
        return input_string

def main_function():
    generated_code = "print('Hello, World!')"
    cleaned_code = prose_guard(generated_code)
    print(cleaned_code)

self_edit_generated.main_function(prose_guard(self_edit_generated.generated_code))