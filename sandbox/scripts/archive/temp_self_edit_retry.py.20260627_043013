def modified_main_function(prompt):
    generated_code = strip_prose(prompt)
    
    if len(generated_code) > 200:
        generated_code = generated_code[:200]
    
    if len(generated_code) > 120:
        generated_code = generated_code[:120] # Truncate if exceeding PEP 8 limit
    
    return generated_code

def optimize_code_length(trial):
    max_len = trial.suggest_int("max_len", 100, 500)
    min_len = trial.suggest_int("min_len", 50, 200)
    
    code = modified_main_function(max_len=max_len, min_len=min_len)
    style_score = -len(code)  # Minimize length to maximize style score
    
    return style_score

def measure_average_response_length():
    initial_length = len(modified_main_function(max_len=500, min_len=100))
    optimized_code = optimize_code_length(optuna.create_study(direction="minimize")).optimize()
    final_length = len(optimized_code)
    
    return initial_length, final_length

def run_optimized_code_generation():
    study = optuna.create_study(direction="minimize")
    study.optimize(optimize_code_length, n_trials=100)
    optimized_code = modified_main_function(max_len=study.best_params["max_len"], min_len=study.best_params["min_len"])
    
    return optimized_code

