import os

def modify_file():
    file_path = "/Users/richietate/Desktop/FeralEcho/symbiote.py"
    try:
        with open(file_path, "r+") as file:
            original_content = file.read()
            modified_content = original_content.replace("Smoothness detected: False | Confidence: 0.4", "Smoothness detected: True | Confidence: 1.0")
            file.seek(0)
            file.write(modified_content)
    except FileNotFoundError:
        print(f"Error: File '{file_path}' not found.")
    else:
        print(f"Modified {file_path} to indicate smoothness with high confidence.")
    finally:
        file.close()