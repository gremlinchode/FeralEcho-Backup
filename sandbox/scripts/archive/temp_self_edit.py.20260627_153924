from app.core.self_edit_generated import *
from typing import List

def strip_leading_prose(code: str) -> str:
    leading_code = ''
    sentences = strip_prose(code).split('. ')
    for sentence in sentences:
        if not any(map(str.__contains__, ["import", "class", "def"])) and len(sentence) < 10:
            continue
        else:
            leading_code += f". {sentence}\n"
    return code.replace(leading_code, '')

problematic_areas = open('app/core/self_edit_generated.py', 'r').read().split('**sandbox_failure_area**:')

for area in problematic_areas[1:]:
    modified_area = strip_leading_prose(area)
    print(f"Modifying {area} to {modified_area}")
    print(modified_area, end='')
print()

open('app/core/self_edit_generated.py', 'w').write(problematic_areas[0] + ''.join([strip_leading_prose(a) for a in problematic_areas[1:]]) + problematic_areas[-1])

