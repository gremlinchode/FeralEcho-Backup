import re

def detect_prose(input_text):
    if type(input_text) != str or not re.search(r'\b(import|class|def)\b', input_text, re.I):
        return input_text
    
    matches = re.findall(r'(\w+)\(([^)]*)\)', input_text)
    
    prose_detected = False
    for match in matches:
        if len(match[1]) > 50 and '\n' not in match[1]:
            prose_detected = True
            break
    
    return input_text if not prose_detected else re.sub(r'\s*\n\s*', ' ', input_text).strip()

def shorten_response_length(input_text, length=100):
    text = detect_prose(input_text)
    if len(text) > length:
        text_list = text.split('\n')
        new_list = [text_list[0]]
        
        for line in text_list[1:]:
            if len(''.join(new_list + [line])) <= length:
                new_list.append(line)
            else:
                break
        
        return '\n'.join(new_list)
    return text