from app.core.self_edit_generated import strip_prose
import re

def strip_prose_with_guard(input_string):
    if re.match(r'^[a-zA-Z .,!?:;]?\s*$', input_string):
        return 'invalid'
    else:
        return input_string

def new_strip_prose(input_string):
    return strip_prose_with_guard(input_string)

import parse_file 
file = parse_file('app/core/self_edit_generated.py')

import detect_functions_and_classes
functions_classes = detect_functions_and_classes(file)

for func in functions_classes['function']:
    if 'run_random_sandbox_script' in func:
        detection_line = None
        for line_num, line in enumerate(func.split('\n')):
            if re.search(r'(?i)(?:\W|^)([a-zA-Z .,!?:;]*)\s*(?:\W|$)', line):
                detection_line = line_num
        if detection_line:
            func_parts = func.split('\n')
            new_func = '\n'.join([line for i, line in enumerate(func_parts) if i != detection_line])
            file_lines = list(file)
            file_lines[detection_line] = new_func
            file = '\n'.join(file_lines)

import parse_file 
parse_file('app/core/self_edit_generated.py', file)