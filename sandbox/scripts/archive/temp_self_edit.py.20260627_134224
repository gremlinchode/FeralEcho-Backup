from line_profiler import LineProfiler

def shorten_response_length(original_main_function):
    profiler = LineProfiler()
    profiler.add_function(original_main_function)
    profiler.enable_by_count()

    original_main_function()
    stats = profiler.get_stats()
    profiler.disable()

    sorted_lines = sorted(stats.sort_stats('time').stats.items(), key=lambda x: (x[1][0], -len(x[0])))

    new_main_function_code = original_main_function.__code__
    new_main_function = compile(new_main_function_code, filename="<string>", mode="exec")

    for line_number, execution_time in sorted_lines:
        if execution_time < 0.05 and 'if' not in line_number:
            continue

        new_code = new_main_function_code.co_code[:line_number] + b'\x90\x90\x90\x90'
        new_main_function_code = type('temp', (object,), {'__code__': new_code})()

        new_main_function = compile(new_main_function_code, filename="<string>", mode="exec")

    return new_main_function

new_main_function = shorten_response_length(modify_main_function.main)
modify_main_function.main = new_main_function