import re
from app.core import self_edit_generated, tool_manager, memory_helpers

def strip_prose(code):
    match = re.match(r"^\s*.*?:\n", code, re.DOTALL)
    if match:
        return code[match.end():]
    return code

def modify_self_edit_generated():
    original_code = self_edit_generated.generate()
    modified_code = strip_prose(original_code)
    self_edit_generated.rewrite(modified_code)

tool_manager.update_self_edit_modifier(modify_self_edit_generated)

trigger_count = 0
previous_output = ""

while True:
    output = self_edit_generated.generate()
    if strip_prose(output):
        trigger_count += 1
        previous_output = output

append_to_journal(f"Prose detection guard triggered {trigger_count} times.")
log_memory_event("Modification successful.")