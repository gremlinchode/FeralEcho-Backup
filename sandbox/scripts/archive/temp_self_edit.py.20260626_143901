import ToolManager
from GeminiShard import *
from deliberate_and_learn import *

class SelfEditGenerated:
    def score_code_candidate(code_string: str) -> int:
        has_imports = parse_file([line for line in code_string.splitlines() if line.lstrip().startswith('import')], 'import')[0]
        functions_classes = detect_functions_and_classes(code_string)
        has_function_def = len(functions_classes) > 0
        no_prose_sentences = all(not line.strip().endswith('.') for line in code_string.splitlines())

        score = int(has_imports) + int(has_function_def) * 2 + int(no_prose_sentences) * 3

        return score