def strip_prose(text):
    try:
        sentences = text.split('. ')
        if sentences[0].strip().isalpha():
            return ' '.join(sentences[1:])
        else:
            return text
    except IndexError:
        return text

shorten_response_length = lambda x: strip_prose(x)(10)

