import re
from app.core.self_edit_generated import strip_prose

def strip_sandbox_output():
    with open('sandbox_output.txt', 'r') as file:
        lines = [line.strip() for line in file.readlines()]
    output = ''
    for line in lines:
        match = re.match(r'^[^#].*?(import|def|class)\b.*\n?', line)
        if match:
            output += match.group(0) + '\n'
        else:
            continue
    with open('sandbox_output.txt', 'w') as file:
        file.write(output)