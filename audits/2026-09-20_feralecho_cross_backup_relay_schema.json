   "type": "string"
  },
  "SAMPLE_COUNT": {
   "pattern": "^[0-9]+$",
   "type": "string"
  },
  "EXIT_STATUS": {
   "pattern": "^[0-9]+$",
   "type": "string"
  },
  "MUTABLE_FILE_COUNT": {
   "pattern": "^[0-9]+$",
   "type": "string"
  },
  "LIVE_MUTATED_COUNT": {
   "pattern": "^[0-9]+$",
   "type": "string"
  },
  "HOSTKEY_FP": {
