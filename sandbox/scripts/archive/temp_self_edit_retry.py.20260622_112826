# import os
file_path = "/Users/richietate/Desktop/FeralEcho/core/awareness.py"
with open(file_path, 'r+') as f:
    lines = f.readlines()
    for i, line in enumerate(lines):
        if line.strip().endswith(']'):
            new_line = "# " + line.strip()[:-1] + "\n"
            modified_lines = lines[:i] + [new_line] + lines[i+1:]
            f.seek(0)
            f.writelines(modified_lines)
    f.truncate()
    print("Modified line:", lines[1])