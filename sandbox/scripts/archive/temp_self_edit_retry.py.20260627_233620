import strip_prose
self_edit_generator = strip_prose.SelfEditGenerated()

def strip_prose_output(code):
    import re
    python_token_regex = re.compile(r'\b[a-zA-Z_][a-zA-Z0-9_]*\(')
    code = code.strip()
    code = python_token_regex.search(code).start() if code else code
    return code

self_edit_generator.strip_prose_output(strip_prose_output)