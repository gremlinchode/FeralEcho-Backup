    def prose_guard(output_string):
        try:
            lines = output_string.splitlines()
            for i, line in enumerate(lines):
                if line.startswith(" "):
                    return line[len(line) - 1:]  # Extract from the last character to avoid errors if output is empty
                elif line.strip():  # Check if line isn't just whitespace
                    break
            return output_string
        except Exception as e:
            print(f"Error in prose_guard: {e}")
            return output_string

    def modify_function_output(output):
        if not output.startswith(" "):
            return output
        python_token = query_ollama(output)
        return output[:python_token]

