import app.core.self_edit_generated
import app.core.memory_write_validator
import tokenize

class SelfEditGenerated(app.core.self_edit_generated.SelfEditGenerated):
    def strip_prose_and_tokenize(self, code_snippet):
        try:
            memory_write_validator.check_schema(code_snippet)
            memory_write_validator.check_recursive_loop(code_snippet)
        except Exception as e:
            return None
        cleaned_code = self.strip_prose(code_snippet).strip()
        if not cleaned_code:
            return None
        return list(tokenize.generate_tokens(compile(cleaned_code, '<string>', 'exec')))

