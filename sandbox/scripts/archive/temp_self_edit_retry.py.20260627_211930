importlib.import_module('app.core.self_edit_generated')

def strip_prose(input_text):
    lines = input_text.split('\n')
    for line in lines:
        words = line.split()
        if len(words) > 0 and not words[0].isnumeric():
            return strip_prose(line + '\n') + lines[1:]
    return input_text

def strip_prose_on_entry(input_text):
    return strip_prose(input_text)

log = print
strip_prose(log(f'Stripped prose {len(strip_prose(input_text))} times'))