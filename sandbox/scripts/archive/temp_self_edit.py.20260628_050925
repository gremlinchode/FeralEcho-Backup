# modify the strip_prose function to detect prose by checking for natural-language sentences at the beginning of the code output
def modified_strip_prose(text):
    import re
    sentence_endings = ['.', '!', '?']
    for ending in sentence_endings:
        if text.strip().startswith(ending):
            return text.strip()[len(ending):].strip()
    return text.strip()

app.core.self_edit_generated.strip_prose = modified_strip_prose

