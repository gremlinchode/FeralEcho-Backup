# Unit tests for strip_leading_natural_language function
import unittest

class TestStripLeadingNaturalLanguage(unittest.TestCase):
    def test_remove_prose(self):
        code = "This is a comment\ndef main_function():\n    print('Hello, world!')"
        expected = "def main_function():\n    print('Hello, world!')"
        self.assertEqual(strip_leading_natural_language(code), expected)

    def test_preserve_python_code(self):
        code = "def main_function():\n    print('Hello, world!')"
        expected = "def main_function():\n    print('Hello, world!')"
        self.assertEqual(strip_leading_natural_language(code), expected)

if __name__ == '__main__':
    unittest.main()