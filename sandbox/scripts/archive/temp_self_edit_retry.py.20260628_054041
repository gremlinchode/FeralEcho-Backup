# Define a function strip_prose within app.core.self_edit_generated.py, utilizing regular expressions to detect and strip prose content preceding the first Python token in code output.
def strip_prose(code):
    pattern = r'[^#]*\n'
    match = re.search(pattern, code)
    if match:
        code = code[:match.start()] + '\n'
    return code

# Modify the existing self_edit_generated function by calling strip_prose on the generated output, ensuring it is processed before being returned as modified code.
self_edit_generated = lambda x: strip_prose(x)(x)

# Update the run_random_sandbox_script function within app.core.sandbox_interface to invoke the revised self_edit_generated function for all sandbox scripts.
def run_random_sandbox_script():
    global self_edit_generated
    return self_edit_generated

