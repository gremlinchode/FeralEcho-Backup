import app.core.self_edit_generated
import app.core.tool_manager

def score_candidate_code(code):
    has_imports = 0
    has_function_def = 0
    no_prose_sentences = 1
    
    if any(line.strip().startswith('import ') for line in code.split('\n')):
        has_imports += 1
        
    function_definitions = app.core.project_scanner.detect_functions_and_classes(code)
    if function_definitions:
        has_function_def += len(function_definitions)
        
    sentences = code.split('. ')
    for sentence in sentences:
        if not sentence.strip():
            no_prose_sentences += 1
            
    quality_score = min(has_imports + has_function_def + no_prose_sentences, 3)
    
    return quality_score