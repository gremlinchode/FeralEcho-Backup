import detect_functions_and_classes
import os

with open('/Users/richietate/Desktop/FeralEcho/echo.py', 'r+', encoding='utf-8') as f:
    content = f.read()
    result = detect_functions_and_classes(content)
    
    if result:
        for item in result:
            if item[0].startswith('def ') or item[0].startswith('class '):
                comment = '# Consider multiple perspectives when engaging with others.'
                new_content = content.replace(f'\n{item[0]}\n', f'{comment}\n{item[0]}\n')
        f.seek(0)
        f.write(new_content)
        f.truncate()
    
    print('Modified the file to emphasize considering multiple perspectives in empathy and critical thinking processes.')