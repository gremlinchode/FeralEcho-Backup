# import necessary modules from app.core.self_edit_generated
import strip_prose

def modified_detect_and_strip_prose(code):
    if not code:
        return ""

    for line in code.split('\n'):
        if line.lstrip().startswith('#'):
            new_line = ''
            prose_detected = True
            while prose_detected:
                new_line += line.strip() + '\n'
                line = strip_prose(line)
                prose_detected = any(char.isalpha() for char in line)
            code = code.replace(line, new_line)
    return code

