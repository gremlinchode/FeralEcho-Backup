# import app.core.awareness_tools_integration
import app.core.project_scanner
import app.core.tool_manager

app.core.awareness_tools_integration.discover_installed_packages()

package_list = app.core.project_scanner.list_python_files()
memory_bridge_file = [file for file in package_list if file == 'memory_bridge.py'][0]

memory_contents = app.core.project_scanner.parse_file(memory_bridge_file)
rebuild_vector_memory_def = memory_contents['rebuild_vector_memory']

tool_entry = app.core.tool_manager.Tool(rebuild_vector_memory_def, 'memory_bridge.py')
app.core.awareness_tools_integration.register_package_functions([tool_entry])

app.core.awareness_tools_integration.safe_wrapper = True