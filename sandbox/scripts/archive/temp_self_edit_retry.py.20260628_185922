# Import necessary modules and functions
import re
from app.core.self_edit_generated import strip_prose, score_code_candidate

def tighten_prose_detection(code):
    if code.lstrip().startswith('#') or re.match(r'^\s*import', code) or re.match(r'^\s*class', code) or re.match(r'^\s*def', code):
        return strip_prose(code)
    else:
        return code

def score_code_candidate(code, tightness=True):
    if tightness:
        return tighten_prose_detection(code)
    else:
        return code