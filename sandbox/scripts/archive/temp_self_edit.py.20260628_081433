def optimize_code_generation(code: str) -> str:
    """Optimize the code generation function by pruning and minimizing output size."""
    optimized_code = ""
    for line in code.splitlines():
        if not line.strip().startswith("#"):
            optimized_code += line + "\n"
    return optimized_code


def recursive_score_code_candidate(code: str, max_depth: int) -> int:
    """Recursively score the code candidate and reduce average response length by 20%."""
    new_code = strip_prose(code)
    if max_depth > 1:
        new_score = recursive_score_code_candidate(new_code, max_depth - 1)
    else:
        new_score = score_code_candidate(new_code)
    return (score_code_candidate(code) + new_score) // 2


