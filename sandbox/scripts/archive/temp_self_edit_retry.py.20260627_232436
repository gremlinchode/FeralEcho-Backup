import re
from app.core.self_edit_generated import strip_prose

def strip_prose(code):
    with open('app/core/self_edit_generated.py', 'r') as f:
        code = f.read()

    start_token_index = min([i for i, line in enumerate(code.split('\n')) if re.match(r'[a-zA-Z]\w*\(', line)])

    prose_lines = [line for line in code.split('\n')[:start_token_index] if not re.match(r'[^a-zA-Z]', line)]

    code = '\n'.join(code.split('\n')[start_token_index:] + [''] * len(prose_lines))

    with open('app/core/self_edit_generated.py', 'w') as f:
        f.write(code)