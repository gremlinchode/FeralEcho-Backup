from app.core.self_edit_generated import strip_prose

self_edit_generated_module = __import__('app.core.self_edit_generated')

def strip_prose(code):
    for line in code.splitlines():
        if any(line.strip().startswith(s) for s in ['The', 'A', 'An', 'It', 'This', 'That']):
            return line.split(' ', 1)[1]
    return code

run_random_sandbox_script = lambda: strip_prose(run_random_sandbox_script())

self_edit_generated_module.run_random_sandbox_script = run_random_sandbox_script

with open('app/core/self_edit_generated.py', 'w') as f:
    f.write(open('app/core/self_edit_generated.py').read().replace('run_random_sandbox_script = lambda:', 'run_random_sandbox_script = lambda: strip_prose('))

