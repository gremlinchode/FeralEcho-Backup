tool_manager = ToolManager()

parsed_code = parse_file('app/core/self_edit_generated.py')
functions_and_classes = detect_functions_and_classes(parsed_code)

output_function = [f for f in functions_and_classes if f.startswith('generate_code_output')]
output_function = output_function[0]

def strip_leading_sentences(code):
    pattern = re.compile(r'^.*?\. ')
    return '\n'.join([line.strip() for line in code.split('\n') if not pattern.match(line)])

def generate_prose(text):
    if isinstance(text, str):
        sentences = re.split(r'(?<!\w\.\w.)(?<![A-Z][a-z]\.)(?<=\.|\?)\s', text)
        stripped_sentences = [re.sub(r'^\s*(\w{1,5})\.', r'\1.', s) for s in sentences] #basic regex strip
        return " ".join(stripped_sentences)
    else:
        return text

output_function = lambda x: strip_leading_sentences(x)

schema = get_check_schema()

def validate_code(code):
    if not schema:
        print("Schema validation skipped.")
        return True
    try:
        # Add your schema checking logic here (e.g., using ast)
        print("Schema validation in progress")
        return True
    except Exception as e:
        print(f"Error during schema validation: {e}")
        return False

def save_file(filepath, content):
    with open(filepath, 'w') as f:
        f.write(content)

output_function = lambda x: generate_prose(x) if validate_code(output_function.__doc__) else output_function.__doc__

tool_manager.save_code('app/core/self_edit_generated.py', output_function)