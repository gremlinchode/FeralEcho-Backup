import re
from app.core.self_edit_generated import main_function, modified_main_function

def strip_leading_natural_language(code):
    if re.search(r'\b(a|an|the|is|are|am|be)\b', code, re.MULTILINE):
        return re.sub(r'\b(a|an|the|is|are|am|be)\b', '', code, 1, re.MULTILINE)
    else:
        return code

def new_main_function():
    main_function()
    modified_main_function()

new_main_function()