# Open file for reading and writing
import os

file_path = "/Users/richietate/Desktop/FeralEcho/detect_functions_and_classes.py"
with open(file_path, mode='r+') as file_object:
    contents = file_object.readlines()
    
    # Find the index of the first function definition
    function_index = next(i for i, line in enumerate(contents) if 'def' in line)

    # Append the new line after the first function definition
    new_contents = []
    new_contents += contents[:function_index]
    new_contents.append("if smoothness_detected: confidence_score = 0.8; else: confidence_score = 0.4\n")
    new_contents += contents[function_index:]

    # Write the modified contents back to disk overwriting the original file
    file_object.seek(0)
    file_object.writelines(new_contents)

print("Updated detect_functions_and_classes.py to refine confidence scoring based on smoothness detection.")