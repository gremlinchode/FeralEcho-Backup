import os
import re

def process_file(filepath):
    try:
        content = parse_file(filepath)
        if content is None:
            return None
        
        modified_content = remove_natural_language(content)
        
        validation_result = validate_code(modified_content)

        if validation_result == "valid":
            save_code(filepath, modified_content)
            return True
        else:
            print(f"Validation failed for {filepath}.  Returning False.")
            return False
    except Exception as e:
        print(f"An error occurred processing {filepath}: {e}")
        return False

def remove_natural_language(content):
    pattern = r"(?s)^.*?\n(?:[a-zA-Z0-9]+)$" 
    cleaned_content = re.sub(pattern, "", content, flags=re.MULTILINE)
    return cleaned_content

def validate_code(content):
    if check_schema(content) and check_reflection_length(content) and check_recursive_loop(content) and check_orientation_data_in_reflection(content):
        return "valid"
    else:
        return "invalid"

def save_code(filepath, content):
    with open(filepath, 'w') as file:
        file.write(content)

