def refactor_main_function():
    refactored_code = []
    for code_section in analyze_python_code(self_edit_module):
        if 'string' not in code_section and 'file I/O' not in code_section and 'external API calls' not in code_section:
            normalized_section = normalize_book(code_section)
            refactored_code.append(normalized_section)

    def generate_responses():
        return [response.strip() for response in refactored_code]

    responses = generate_responses()
    average_length = sum(len(response) for response in responses) / len(responses)
    desired_average_length = 0.8 * average_length

    if desired_average_length < average_length:
        parsed_responses = []
        for response in responses:
            parse_result = parse_minimal(response)
            if len(parse_result) > desired_average_length:
                refactored_responses.append(parse_result[:desired_average_length])
            else:
                refactored_responses.append(response)

    def validate_code():
        return validate_code(refactored_responses)

    validation_results = validate_code()
    if all(validation_results):
        self_edit_module.save_plan()

def main_function(input_data):
    refactor_main_function()

main_function()