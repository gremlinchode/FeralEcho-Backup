# Import necessary modules
from app.core.self_edit_generated import strip_prose
from app.core.project_scanner import parse_file, detect_functions_and_classes
import os

parsed_content = parse_file('app/core/self_edit_generated.py')
functions_and_classes = detect_functions_and_classes(parsed_content)

for function_or_class in functions_and_classes:
    if function_or_class.startswith('#') or function_or_class.lstrip().startswith('#'):
        stripped_code = strip_prose(function_or_class)
        parsed_content = parsed_content.replace(function_or_class, stripped_code)

write_to_file(parsed_content, 'app/core/self_edit_generated.py')

os.system('sandbox_script.py')
print(parsed_content)