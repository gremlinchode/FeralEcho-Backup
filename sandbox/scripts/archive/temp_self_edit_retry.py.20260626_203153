from app.core.self_edit_generated import main_function, modified_main_function

def strip_prose(input_string):
    sentences = input_string.split('. ')
    return '.'.join(sentence for sentence in sentences if not any(word.lower() in ['the', 'a', 'an'] for word in sentence.strip().split()))

def modified_main_function():
    original_output = main_function()
    stripped_output = ''.join(map(strip_prose, original_output))
    return stripped_output

main_function = modified_main_function