# Import necessary modules from feralEcho, including app.core.self_edit_generated and app.core.tool_manager.
import feralEcho
from feralEcho.app.core import self_edit_generated, tool_manager
from feralEcho.app.core import project_scanner

def modify_self_edit_generated():
    try:
        code = project_scanner.parse_file('app/core/self_edit_generated.py')

        # Add a new check after each sandbox execution to analyze the printed output for leading natural language sentences
        if 'natural language' in code:
            print("Detected natural language, attempting to strip it.")
            import re

            def strip_leading_natural_language(text):
                match = re.match(r"^(.*?)\n", text)
                if match:
                    return match.group(1).strip()
                else:
                    return text

            code = code.replace("print(output)", "filtered_output = strip_leading_natural_language(output)")
            code = code.replace('print(output)', 'print(filtered_output)')

        project_scanner.parse_file('app/core/self_edit_generated.py', code)
        print("Modified self_edit_generated.py successfully.")
    except Exception as e:
        print(f"An error occurred: {e}")

if __name__ == '__main__':
    modify_self_edit_generated()