import os; import re

file = open("/Users/richietate/Desktop/FeralEcho/echo.py", "r+")

pattern = re.compile(b'Smoothness detected: False | Confidence: \d+\.4')
match = pattern.search(file.read())
if match:
    file.seek(match.start(), 0)
    replacement = b'"Smoothness detected: False | Confidence: 0.5"\n'
    file.write(replacement)
file.close()
print("Confidence updated from 0.4 to 0.5")