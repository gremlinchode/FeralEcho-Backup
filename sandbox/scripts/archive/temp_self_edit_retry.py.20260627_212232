import importlib.util
from app.emergent_scheduler_backup_20260610 import *
from app.core.self_edit_generated import *

def detect_prose(code):
    for line in code.split('\n'):
        if line and (line[0].isupper() or line[0] in ['.', ',', '?']):
            return True
    return False

strip_prose = self_edit_generated.strip_prose

sandbox_script = '''
import os
os.system('cls' if os.name == 'nt' else 'clear')
'''

def modified_sandbox_script(code):
    if detect_prose(code):
        code = strip_prose(code)
    return sandbox_script + code

run_random_sandbox_script = modified_sandbox_script