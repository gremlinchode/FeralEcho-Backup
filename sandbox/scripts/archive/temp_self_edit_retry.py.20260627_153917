# import re

with open('app/core/self_edit_generated.py', 'r') as f:
    original_code = f.read()
prose_pattern = re.compile(r'(?m)^(\w+(?:\W+)*).*')
modified_code = ''
for line in original_code.split('\n'):
    if prose_pattern.match(line):
        sentence, _ = line.split('\n', 1)
        modified_line = sentence.split(' ')[-1].strip()
        modified_code += '    ' + modified_line + '\n'
    else:
        modified_code += line + '\n'
with open('app/core/self_edit_generated.py', 'w') as f:
    f.write(modified_code)