def score_code_candidate(candidate_code):
    quality_score = 0
    if any(line.startswith("import") for line in candidate_code.splitlines()):
        quality_score += 1
        
    if any(line.startswith("def ") or line.startswith("class ") for line in candidate_code.splitlines()):
        quality_score += 1
        
    return quality_score