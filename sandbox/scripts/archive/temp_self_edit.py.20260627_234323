import strip_prose
import re

code = open('app/core/self_edit_generated.py', 'r').read()
prose_match = re.search(r'\b[a-zA-Z ]+\b', code)

if prose_match and not re.search(r'[^\w\s]', code[:100]):
    code = re.sub(r'^(.*?)\s*([a-zA-Z])', r'\2', code, flags=re.M)
    with open('app/core/self_edit_generated.py', 'w') as f:
        f.write(code)

import self_edit_generated