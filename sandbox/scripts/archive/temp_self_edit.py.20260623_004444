import os
re = __import__('re')

project_path = "/Users/richietate/Desktop/FeralEcho/"
file_path = os.path.join(project_path, "response.py")
code = ''

with open(file_path, 'r') as f:
    code = f.read()

modified_code = re.sub(r'proj\s+', r"proj" + os.pathsep, code)

with open(file_path, 'w') as f:
    f.write(modified_code)

print(f"Modified '{file_path}' to replace the missing quote after 'proj'.")