import re

def main():
    tool_manager = app.core.tool_manager
    scanner = app.core.project_scanner
    
    code = scanner.parse_file('app/core/self_edit_generated.py')
    
    def generate_code_output(code):
        prose_pattern = re.compile(r'^(?!\s*\w+\s*=\s*[\'"][^"]+["\']|print\s*\().*').sub('', code)
        return prose_pattern

    main_function = scanner.update_main_function(code, generate_code_output)
    
    scanner.parse_file('app/core/self_edit_generated.py', main_function)
    
    files = scanner.list_python_files()
    print(files)

if __name__ == "__main__":
    main()