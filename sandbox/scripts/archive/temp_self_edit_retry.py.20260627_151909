# import necessary modules from app.core.self_edit_generated, specifically strip_prose
import strip_prose

def detect_and_strip_prose(sandbox_script_output):
    python_token_index = next((i for i, c in enumerate(sandbox_script_output) if not c.isalpha()), None)
    if python_token_index is not None:
        prose_text = sandbox_script_output[:python_token_index].strip()
        modified_sandbox_script_output = strip_prose.strip_prose(prose_text)
        return modified_sandbox_script_output
    else:
        return sandbox_script_output