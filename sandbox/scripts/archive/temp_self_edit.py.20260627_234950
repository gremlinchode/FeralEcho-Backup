import strip_prose

def remove_leading_prose(code):
    import re
    prose_pattern = r'(?m)^.*?(?:\n\s*\n|$)'
    if re.search(prose_pattern, code):
        return strip_prose(re.sub(r'(?m)^[ \t]+', '', code).strip())
    else:
        return code

from app.core.self_edit_generated import self_edit_logic
self_edit_logic = lambda x: remove_leading_prose(x)(**self_edit_logic)

import app.core.self_edit_generated
app.core.self_edit_generated = app.core.self_edit_generated(**app.core.self_edit_generated)