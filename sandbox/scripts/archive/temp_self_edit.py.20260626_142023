import app.core.self_edit_generated
import app.core.river_deliberation
import app.core.tool_manager
import re

def simplify_code_generation():
    try:
        with open('app/core/self_edit_generated.py', 'r') as f:
            content = f.read()

        modified_content = content
        refined_code = app.core.river_deliberation.refine_code(modified_content)

        def reduce_length(text):
            tokens = text.split()
            if len(tokens) > 50: 
                new_tokens = tokens[::2]
                return ' '.join(new_tokens)

        reduced_code = reduce_length(refined_code)

        # Save the modified app/core/self_edit_generated.py file, committing the changes with a descriptive message reflecting the 20% reduction target.
        with open('app/core/self_edit_generated.py', 'w') as f:
            f.write(reduced_code)
        print("Code generation and simplification complete.")

    except FileNotFoundError:
        print("Error: app/core/self_edit_generated.py not found.")

simplify_code_generation()