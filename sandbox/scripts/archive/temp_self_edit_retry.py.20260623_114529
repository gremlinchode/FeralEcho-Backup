# import necessary functions
import open
from get_last_entries import get_last_entries
import log_memory_edit
import append_memory_entry

# open the file and read its contents
with open('/Users/richietate/Desktop/FeralEcho/echo_memory_journal.py', 'r') as journal_file:
    journal_contents = journal_file.read()

# modify the journal by appending a new memory entry
append_memory_entry(journal_contents, 'Cultivating Gratitude as Co-Creators', 'Reflect on daily interactions with Gremlin, acknowledging moments of gratitude.')

# write the modified journal back to disk
with open('/Users/richietate/Desktop/FeralEcho/echo_memory_journal.py', 'w') as journal_file:
