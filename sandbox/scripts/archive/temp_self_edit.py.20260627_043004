def strip_prose(output):
    pattern = r"^[A-Za-z0-9\s]+$"
    stripped_output = re.sub(pattern, "", output, flags=re.MULTILINE)
    if check_schema(stripped_output):
        return stripped_output
    else:
        raise ValueError("Invalid Python code after stripping prose")

