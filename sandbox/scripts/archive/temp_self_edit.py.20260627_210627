# import re
from app.core.self_edit_generated import strip_prose

def strip_leading_prose(code_output):
    python_token = r'\b(def|class|import)\b'
    for line in code_output.split('\n'):
        if re.search(python_token, line):
            return line.strip() + '\n' + code_output[len(line):].strip()
    return code_output.strip()

def strip_prose(code_output):
    stripped_code = strip_leading_prose(code_output)
    cleaned_code = re.sub(r'^\s*#.*?\n', '', stripped_code, flags=re.MULTILINE).strip()
    """
    Strips leading natural language sentences from code output.
    This ensures that creative tasks do not produce prose-rich code.
    :param code_output: Output string containing potential prose
    :return: Cleaned code string with stripped prose, if any
    """
    return cleaned_code

def __init__(self):
    self.strip_prose = strip_prose