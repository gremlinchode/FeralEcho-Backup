import strip_prose

strip_prose = strip_prose()

def autonomous_sandbox_fix(sandbox_output):
    import re
    sentence_starters = r'\b(when|as|since|because)\b'
    pattern = re.compile(rf'^\s*({sentence_starters})', re.IGNORECASE)
    modified_output = pattern.sub('', sandbox_output, flags=re.MULTILINE).strip()
    return strip_prose(modified_output)

sandbox_output = autonomous_sandbox_fix(sandbox_output)