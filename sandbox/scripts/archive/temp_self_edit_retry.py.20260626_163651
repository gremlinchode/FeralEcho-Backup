import re
from feralEcho.app.core.self_edit_generated import self_edit_module, main_function
from feralEcho.app.core.detect_functions_and_classes import detect_functions_and_classes
from feralEcho.app.core.check_schema import check_schema
from feralEcho.app.core.save_code import save_code
from feralEcho.app.core.self_model_updater import SelfModelUpdater
from feralEcho.app.core.run_random_sandbox_script import run_random_sandbox_script

def strip_prose(code):
    regex = r'^.*\n\s*\w+\s*'  # Regex to remove leading natural language sentences
    return re.sub(regex, '', str(code)).strip()

main_function = lambda: strip_prose(main_function)()

ValidationResult = check_schema(validate_code(main_function))
if ValidationResult.is_valid:
    modified_self_edit_module = parse_file('app/core/self_edit_generated.py')
    save_code(modified_self_edit_module)
    SelfModelUpdater().start()
    run_random_sandbox_script(main_function)