# import necessary modules
from app.core.memory_tools import get_last_entries, append_to_journal
from app.core.self_edit_manager import validate_code, save_code
from app.core.tool_manager import ToolManager
import re

file_path = "app/core/self_edit_generated.py"
code_content = parse_file(file_path)

function_name_to_modify = "main_function"
function_content, start_index, end_index = detect_functions_and_classes(code_content, function_name_to_modify)

def strip_prose(output):
    match = re.search(r'\b(import|class|def)\b', output, re.IGNORECASE)
    if match:
        return output[match.start():]
    return ''

modified_function_content = """
def main_function():
    output = {}
    # Original code here
    output['reasoning'] = strip_prose(output['reasoning'])
    return output
"""

code_content = code_content[:start_index] + modified_function_content + code_content[end_index:]
save_code(file_path, code_content)

test_function = get_relevant_memories().get_test_case_for("autonomous self-edit")
if validate_code(test_function):
    append_to_journal("Autonomous self-edit successful.")
else:
    append_to_journal("Autonomous self-edit failed.")

append_to_journal(f"Modified function: {function_name_to_modify}")