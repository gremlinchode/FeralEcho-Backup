def score_candidate_code(candidate_code):
    has_imports = 0
    has_function_def = 0
    no_prose_sentences = 0
    
    if "import" in candidate_code:
        has_imports += 1
    
    if "def" in candidate_code and "(" in candidate_code and ")" in candidate_code:
        has_function_def += 1
    
    sentences = [sentence.strip() for sentence in candidate_code.split(".")]
    for sentence in sentences:
        if len(sentence) > 0 and sentence[-1] == '.':
            no_prose_sentences += 1
    
    return has_imports + has_function_def + no_prose_sentences